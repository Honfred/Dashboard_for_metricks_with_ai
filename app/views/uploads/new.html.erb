<div class="container mt-4">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><%= link_to t('uploads.title'), uploads_path %></li>
      <li class="breadcrumb-item active"><%= t('uploads.new') %></li>
    </ol>
  </nav>

  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0"><%= t('uploads.new') %></h5>
        </div>
        <div class="card-body">
          <%= form_with model: @uploaded_file, local: true do |f| %>
            <% if @uploaded_file.errors.any? %>
              <div class="alert alert-danger">
                <ul class="mb-0">
                  <% @uploaded_file.errors.full_messages.each do |msg| %>
                    <li><%= msg %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="mb-3">
              <%= f.label :file, t('uploads.file'), class: 'form-label' %>
              <%= f.file_field :file, class: 'form-control', required: true %>
              <div class="form-text"><%= t('uploads.max_size', size: '50MB') %></div>
            </div>

            <div class="mb-3">
              <%= f.label :name, t('uploads.filename'), class: 'form-label' %>
              <%= f.text_field :name, class: 'form-control', 
                  placeholder: t('uploads.name_placeholder') %>
              <div class="form-text"><%= t('uploads.name_hint') %></div>
            </div>

            <div class="row">
              <div class="col-md-6 mb-3">
                <%= f.label :file_type, t('uploads.type'), class: 'form-label' %>
                <%= f.select :file_type, [
                  [t('uploads.types.log'), 'log'],
                  [t('uploads.types.screenshot'), 'screenshot'],
                  [t('uploads.types.config'), 'config'],
                  [t('uploads.types.metrics_import'), 'metrics_import'],
                  [t('uploads.types.other'), 'other']
                ], {}, class: 'form-select' %>
              </div>

              <div class="col-md-6 mb-3">
                <%= f.label :category, t('uploads.category'), class: 'form-label' %>
                <%= f.text_field :category, class: 'form-control', 
                    placeholder: t('uploads.category_placeholder') %>
              </div>
            </div>

            <div class="mb-3">
              <%= f.label :description, t('uploads.description'), class: 'form-label' %>
              <%= f.text_area :description, class: 'form-control', rows: 3 %>
            </div>

            <div class="d-flex gap-2">
              <%= f.submit t('uploads.upload'), class: 'btn btn-primary' %>
              <%= link_to t('common.cancel'), uploads_path, class: 'btn btn-outline-secondary' %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

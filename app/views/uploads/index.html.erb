<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1><%= t('uploads.title') %></h1>
    <%= link_to t('uploads.new'), new_upload_path, class: 'btn btn-primary' %>
  </div>

  <!-- Фильтры -->
  <div class="card mb-4">
    <div class="card-body">
      <%= form_tag uploads_path, method: :get, class: 'd-flex gap-3' do %>
        <div class="flex-grow-1">
          <%= select_tag :file_type, 
              options_for_select([
                [t('uploads.all_types'), ''],
                [t('uploads.types.log'), 'log'],
                [t('uploads.types.screenshot'), 'screenshot'],
                [t('uploads.types.config'), 'config'],
                [t('uploads.types.metrics_import'), 'metrics_import'],
                [t('uploads.types.other'), 'other']
              ], params[:file_type]),
              class: 'form-select' %>
        </div>
        <div class="flex-grow-1">
          <%= text_field_tag :category, params[:category], 
              placeholder: t('uploads.category'), 
              class: 'form-control' %>
        </div>
        <%= submit_tag t('common.filter'), class: 'btn btn-outline-secondary' %>
      <% end %>
    </div>
  </div>

  <!-- Таблица файлов -->
  <div class="card">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead>
          <tr>
            <th><%= t('uploads.filename') %></th>
            <th><%= t('uploads.type') %></th>
            <th><%= t('uploads.category') %></th>
            <th><%= t('uploads.size') %></th>
            <th><%= t('uploads.uploaded_at') %></th>
            <th><%= t('common.actions') %></th>
          </tr>
        </thead>
        <tbody>
          <% @uploaded_files.each do |file| %>
            <tr>
              <td>
                <% if file.image? %>
                  <i class="bi bi-image text-success me-2"></i>
                <% elsif file.text? %>
                  <i class="bi bi-file-text text-info me-2"></i>
                <% else %>
                  <i class="bi bi-file-earmark me-2"></i>
                <% end %>
                <%= link_to file.name, file %>
              </td>
              <td><span class="badge bg-secondary"><%= file.file_type %></span></td>
              <td><%= file.category || '-' %></td>
              <td><%= file.file_size_human %></td>
              <td><%= l(file.created_at, format: :short) %></td>
              <td>
                <div class="btn-group btn-group-sm">
                  <%= link_to download_upload_path(file), class: 'btn btn-outline-primary' do %>
                    <i class="bi bi-download"></i>
                  <% end %>
                  <%= link_to file, method: :delete, 
                      data: { confirm: t('common.confirm_delete') },
                      class: 'btn btn-outline-danger' do %>
                    <i class="bi bi-trash"></i>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Пагинация -->
  <div class="d-flex justify-content-center mt-4">
    <%= paginate @uploaded_files %>
  </div>
</div>

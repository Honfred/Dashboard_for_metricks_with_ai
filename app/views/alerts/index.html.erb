<% content_for :head do %>
  <%= stylesheet_link_tag "alerts" %>
<% end %>

<div class="alerts-container">
  <h1><%= t('alerts.title') %></h1>
  
  <div class="alerts-filters">
    <form action="<%= request.path %>" method="get" class="form-inline"
          data-turbo-frame="alerts-list" data-turbo-action="advance">
      <div class="filter-group">
        <label for="severity"><%= t('alerts.severity.label') %></label>
        <select name="severity" id="severity" class="form-select form-select-sm">
          <option value=""><%= t('common.all') %></option>
          <option value="info" <%= params[:severity] == 'info' ? 'selected' : '' %>><%= t('alerts.severity.info') %></option>
          <option value="warning" <%= params[:severity] == 'warning' ? 'selected' : '' %>><%= t('alerts.severity.warning') %></option>
          <option value="critical" <%= params[:severity] == 'critical' ? 'selected' : '' %>><%= t('alerts.severity.critical') %></option>
        </select>
      </div>
      
      <div class="filter-group">
        <label for="service"><%= t('alerts.service_label') %></label>
        <input type="text" name="service" id="service" value="<%= params[:service] %>" class="form-control form-control-sm" placeholder="<%= t('alerts.service_placeholder') %>">
      </div>
      
      <button type="submit" class="btn btn-primary btn-sm"><%= t('alerts.filter_button') %></button>
    </form>
    
    <div class="alerts-actions">
      <a href="<%= active_alerts_path %>" class="btn btn-outline-primary <%= current_page?(active_alerts_path) ? 'active' : '' %>"><%= t('alerts.active_alerts') %></a>
      <a href="<%= alerts_path %>" class="btn btn-outline-primary <%= current_page?(alerts_path) && !current_page?(active_alerts_path) ? 'active' : '' %>"><%= t('alerts.all_alerts') %></a>
    </div>
  </div>
  
  <%= turbo_frame_tag "alerts-list", data: { turbo_action: "advance" } do %>
    <div class="alerts-list">
      <% if @alerts.any? %>
        <table class="table table-striped">
          <thead>
            <tr>
              <th><%= t('alerts.table.service') %></th>
              <th><%= t('alerts.table.metric') %></th>
              <th><%= t('alerts.table.value') %></th>
              <th><%= t('alerts.table.threshold') %></th>
              <th><%= t('alerts.table.severity') %></th>
              <th><%= t('alerts.table.status') %></th>
              <th><%= t('alerts.table.time') %></th>
              <th><%= t('alerts.table.actions') %></th>
            </tr>
          </thead>
          <tbody>
            <% @alerts.each do |alert| %>
              <tr class="alert-row <%= alert.severity %>">
                <td><%= alert.service %></td>
                <td><%= alert.metric %></td>
                <td><%= alert.value %></td>
                <td><%= alert.threshold %></td>
                <td>
                  <span class="badge bg-<%= { 'info' => 'info', 'warning' => 'warning', 'critical' => 'danger' }[alert.severity] %>">
                    <%= t("alerts.severity.#{alert.severity}") %>
                  </span>
                </td>
                <td>
                  <span class="badge bg-<%= { 'triggered' => 'danger', 'acknowledged' => 'warning', 'resolved' => 'success' }[alert.status] %>">
                    <%= t("alerts.status.#{alert.status}") %>
                  </span>
                </td>
                <td><%= l(alert.triggered_at, format: :default) %></td>
                <td>
                  <div class="btn-group">
                    <a href="<%= alert_path(alert) %>" class="btn btn-sm btn-outline-primary"><%= t('alerts.actions.details') %></a>
                    <% if alert.active? %>
                      <%= button_to t('alerts.actions.acknowledge'), acknowledge_alert_path(alert), method: :post, class: 'btn btn-sm btn-outline-warning' %>
                      <%= button_to t('alerts.actions.resolve'), resolve_alert_path(alert), method: :post, class: 'btn btn-sm btn-outline-success' %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>

        <div class="pagination">
          <%= paginate @alerts %>
        </div>
      <% else %>
        <div class="alert alert-info">
          <%= t('alerts.no_alerts') %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

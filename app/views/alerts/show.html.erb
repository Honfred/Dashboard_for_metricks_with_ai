<div class="alert-details-container">
  <div class="alert-header">
    <h1>Детали оповещения</h1>
    <div class="alert-actions">
      <a href="<%= alerts_path %>" class="btn btn-outline-primary">Назад к списку</a>
      <% if @alert.active? %>
        <%= button_to 'Принять', acknowledge_alert_path(@alert), method: :post, class: 'btn btn-outline-warning' %>
        <%= button_to 'Решить', resolve_alert_path(@alert), method: :post, class: 'btn btn-outline-success' %>
      <% end %>
    </div>
  </div>
  
  <div class="alert-card">
    <div class="alert-status-badge badge bg-<%= { 'triggered' => 'danger', 'acknowledged' => 'warning', 'resolved' => 'success' }[@alert.status] %>">
      <%= { 'triggered' => 'Активно', 'acknowledged' => 'Принято', 'resolved' => 'Решено' }[@alert.status] %>
    </div>
    
    <div class="alert-info-row">
      <div class="alert-info-item">
        <h3>Сервис</h3>
        <p><%= @alert.service %></p>
      </div>
      
      <div class="alert-info-item">
        <h3>Метрика</h3>
        <p><%= @alert.metric %></p>
      </div>
      
      <div class="alert-info-item">
        <h3>Важность</h3>
        <p>
          <span class="badge bg-<%= { 'info' => 'info', 'warning' => 'warning', 'critical' => 'danger' }[@alert.severity] %>">
            <%= { 'info' => 'Информация', 'warning' => 'Предупреждение', 'critical' => 'Критическое' }[@alert.severity] %>
          </span>
        </p>
      </div>
    </div>
    
    <div class="alert-info-row">
      <div class="alert-info-item">
        <h3>Текущее значение</h3>
        <p class="alert-value"><%= @alert.value %></p>
      </div>
      
      <div class="alert-info-item">
        <h3>Пороговое значение</h3>
        <p class="alert-threshold"><%= @alert.threshold %></p>
      </div>
      
      <div class="alert-info-item">
        <h3>Отклонение</h3>
        <p class="<%= @alert.value > @alert.threshold ? 'text-danger' : 'text-success' %>">
          <%= number_to_percentage((@alert.value - @alert.threshold) / @alert.threshold * 100, precision: 2) %>
        </p>
      </div>
    </div>
    
    <div class="alert-timeline">
      <div class="alert-info-item">
        <h3>Время активации</h3>
        <p><%= @alert.triggered_at&.strftime("%d.%m.%Y %H:%M:%S") || 'Неизвестно' %></p>
      </div>
      
      <% if @alert.resolved? %>
        <div class="alert-info-item">
          <h3>Время решения</h3>
          <p><%= @alert.resolved_at&.strftime("%d.%m.%Y %H:%M:%S") || 'Неизвестно' %></p>
        </div>
        
        <div class="alert-info-item">
          <h3>Длительность</h3>
          <p>
            <%= distance_of_time_in_words(@alert.triggered_at, @alert.resolved_at) if @alert.triggered_at && @alert.resolved_at %>
          </p>
        </div>
      <% else %>
        <div class="alert-info-item">
          <h3>Длительность</h3>
          <p>
            <%= distance_of_time_in_words(@alert.triggered_at, Time.current) if @alert.triggered_at %>
          </p>
        </div>
      <% end %>
    </div>
    
    <div class="alert-message">
      <h3>Сообщение</h3>
      <p><%= @alert.message %></p>
    </div>
    
    <% if @alert.active? %>
      <div class="alert-form">
        <h3>Обновить оповещение</h3>
        <%= form_with(model: @alert, local: true) do |form| %>
          <div class="form-group">
            <%= form.label :message, 'Сообщение' %>
            <%= form.text_area :message, class: 'form-control' %>
          </div>
          
          <div class="form-group">
            <%= form.label :severity, 'Важность' %>
            <%= form.select :severity, options_for_select([['Информация', 'info'], ['Предупреждение', 'warning'], ['Критическое', 'critical']], @alert.severity), {}, { class: 'form-select' } %>
          </div>
          
          <div class="form-actions">
            <%= form.submit 'Обновить', class: 'btn btn-primary' %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<style>
  .alert-details-container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 20px;
  }
  
  .alert-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
  }
  
  .alert-actions {
    display: flex;
    gap: 10px;
  }
  
  .alert-card {
    background: white;
    border-radius: 8px;
    box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    padding: 25px;
    position: relative;
    margin-bottom: 20px;
  }
  
  .alert-status-badge {
    position: absolute;
    top: -10px;
    right: 20px;
    padding: 8px 16px;
    font-size: 14px;
    text-transform: uppercase;
  }
  
  .alert-info-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 20px;
  }
  
  .alert-info-item {
    flex: 1;
    margin-right: 20px;
  }
  
  .alert-info-item:last-child {
    margin-right: 0;
  }
  
  .alert-info-item h3 {
    font-size: 14px;
    color: #6c757d;
    margin-bottom: 5px;
    text-transform: uppercase;
  }
  
  .alert-info-item p {
    font-size: 18px;
    margin: 0;
  }
  
  .alert-value,
  .alert-threshold {
    font-weight: bold;
    font-size: 22px;
  }
  
  .alert-timeline {
    display: flex;
    justify-content: space-between;
    margin-bottom: 20px;
    padding-top: 15px;
    border-top: 1px solid #eee;
  }
  
  .alert-message {
    margin-bottom: 20px;
    padding-top: 15px;
    border-top: 1px solid #eee;
  }
  
  .alert-form {
    margin-top: 30px;
    padding-top: 15px;
    border-top: 1px solid #eee;
  }
  
  .form-group {
    margin-bottom: 15px;
  }
  
  .form-actions {
    margin-top: 20px;
  }
</style>

    function saveCurrentLayout() {
      // Собираем текущие настройки
      const settings = {
        time_range: document.getElementById('time-range').value,
        refresh_interval: document.getElementById('auto-refresh').value,
        displayed_panels: Array.from(document.querySelectorAll('.panel-toggle:checked')).map(el => el.dataset.panel),
        layout: getCurrentLayout()
      };
      
      // Сохраняем в localStorage
      localStorage.setItem('dashboardSettings', JSON.stringify(settings));
      
      console.log('Настройки сохранены в localStorage:', settings);
      
      // Отправляем на сервер
      fetch('/dashboard/save_settings', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content || ''
        },
        body: JSON.stringify({ settings: settings })
      })
      .then(response => {
        if (!response.ok) {
          throw new Error('Ошибка при сохранении настроек на сервере');
        }
        return response.json();
      })
      .then(data => {
        console.log('Настройки успешно сохранены на сервере:', data);
        alert('Настройки успешно сохранены');
      })
      .catch(error => {
        console.error('Ошибка при сохранении настроек:', error);
        alert('Настройки сохранены локально, но не удалось сохранить на сервере: ' + error.message);
      });
    }
    
    function getCurrentLayout() {
      // Собираем текущее расположение панелей
      const rows = [];
      
      document.querySelectorAll('.grid-row').forEach(rowEl => {
        const panels = Array.from(rowEl.querySelectorAll('.grid-panel')).map(panelEl => {
          // Генерируем уникальный ID, если его нет
          const panelId = panelEl.id || `panel-${panelEl.dataset.panel}`;
          return {
            id: panelId,
            dataPanel: panelEl.dataset.panel,
            visible: panelEl.style.display !== 'none'
          };
        });
        rows.push({ panels: panels });
      });
      
      return { rows: rows };
    }
    
    function togglePanelVisibility(panelId, isVisible) {
      document.querySelectorAll(`.grid-panel[data-panel="${panelId}"]`).forEach(panel => {
        panel.style.display = isVisible ? 'block' : 'none';
      });
      
      // Проверяем, есть ли видимые панели в каждом ряду
      checkEmptyRows();
      
      // Проверяем, не отключены ли все панели
      checkAllPanelsDisabled();
    }
    
    function checkEmptyRows() {
      document.querySelectorAll('.grid-row').forEach(row => {
        // Проверяем наличие видимых панелей в ряду
        const hasVisiblePanels = Array.from(row.querySelectorAll('.grid-panel')).some(panel => {
          // Учитываем как display:none, так и класс d-none
          return panel.style.display !== 'none' && !panel.classList.contains('d-none');
        });
        
        // Если нет видимых панелей, скрываем ряд
        row.style.display = hasVisiblePanels ? 'flex' : 'none';
      });
    }
    
    function checkAllPanelsDisabled() {
      const allDisabled = !document.querySelectorAll('.panel-toggle:checked').length;
      const noDataEl = document.getElementById('no-panels-message');
      
      if (allDisabled) {
        if (!noDataEl) {
          const message = document.createElement('div');
          message.id = 'no-panels-message';
          message.className = 'no-panels-message';
          message.innerHTML = `
            <div class="alert alert-info">
              <i class="fa fa-info-circle"></i>
              <p>Все панели скрыты. Включите хотя бы одну панель для отображения метрик.</p>
              <button id="show-all-panels" class="btn btn-outline-primary">Показать все панели</button>
            </div>
          `;
          document.getElementById('metrics-grid').appendChild(message);
          
          document.getElementById('show-all-panels').addEventListener('click', showAllPanels);
        }
      } else if (noDataEl) {
        noDataEl.remove();
      }
    }
    
    function showAllPanels() {
      document.querySelectorAll('.panel-toggle').forEach(checkbox => {
        checkbox.checked = true;
        const panel = checkbox.dataset.panel;
        document.querySelectorAll(`.grid-panel[data-panel="${panel}"]`).forEach(panelEl => {
          panelEl.style.display = 'block';
        });
      });
      
      checkEmptyRows();
      checkAllPanelsDisabled();
    }
    
    function toggleFullscreen(e) {
      // Предотвращаем всплытие события на родительские элементы
      e.preventDefault();
      e.stopPropagation();
      
      // Получаем панель, в которой находится кнопка
      const panel = this.closest('.grid-panel');
      const panelType = panel.dataset.panel; // Получаем тип панели по data-panel атрибуту
      
      // Переключаем класс fullscreen
      panel.classList.toggle('fullscreen');
      
      // Обновляем иконку и подсказку
      if (panel.classList.contains('fullscreen')) {
        this.innerHTML = '<i class="fa fa-compress"></i>';
        this.title = 'Выйти из полноэкранного режима';
        document.body.style.overflow = 'hidden'; // Предотвращаем прокрутку страницы
      } else {
        this.innerHTML = '<i class="fa fa-expand"></i>';
        this.title = 'На весь экран';
        document.body.style.overflow = ''; // Восстанавливаем прокрутку страницы
      }
      
      // Пересоздаем график в полноэкранном режиме для корректного размера
      setTimeout(() => {
        if (panelType === 'service-health') {
          // Для таблицы сервисов не нужно пересоздавать график
          // Просто проверяем наличие таблицы и создаем ее, если нужно
          const container = panel.querySelector('.chart-container');
          if (container && !container.querySelector('.status-table')) {
            renderServiceHealthTable(container.id, generateServiceHealthData());
          }
        } else {
          // Для графиков выполняем resize или пересоздаем
          let chartToUpdate;
          
          if (panelType === 'response-time' && charts.responseTime) {
            chartToUpdate = charts.responseTime;
          } else if (panelType === 'throughput' && charts.throughput) {
            chartToUpdate = charts.throughput;
          } else if (panelType === 'error-rate' && charts.errorRate) {
            chartToUpdate = charts.errorRate;
          } else if (panelType === 'resource-usage') {
            // Для ресурсов обновляем все три графика
            if (charts.resourceOverview) charts.resourceOverview.resize();
            if (charts.cpuUsage) charts.cpuUsage.resize();
            if (charts.memoryUsage) charts.memoryUsage.resize();
            return; // Выходим, так как все графики уже обновлены
          }
          
          // Обновляем размер графика, если он существует
          if (chartToUpdate && typeof chartToUpdate.resize === 'function') {
            chartToUpdate.resize();
          }
        }
      }, 300); // Небольшая задержка для завершения анимации
    }
    

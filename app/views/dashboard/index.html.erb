    // Функция для загрузки сохраненного макета
    function loadSavedLayout() {
      // Пробуем загрузить из localStorage
      const savedLayout = localStorage.getItem('dashboardLayout');
      const savedSettings = localStorage.getItem('dashboardSettings');
      
      try {
        // Сначала пробуем загрузить полные настройки
        if (savedSettings) {
          console.log('Загружаем сохраненные настройки из localStorage');
          const settings = JSON.parse(savedSettings);
          
          // Применяем настройки интерфейса
          if (settings.time_range) {
            document.getElementById('time-range').value = settings.time_range;
          }
          
          if (settings.refresh_interval) {
            document.getElementById('auto-refresh').value = settings.refresh_interval;
            setupAutoRefresh(); // Обновляем интервал автообновления
          }
          
          // Применяем видимость панелей
          if (settings.displayed_panels) {
            document.querySelectorAll('.panel-toggle').forEach(checkbox => {
              const panelId = checkbox.dataset.panel;
              const isVisible = settings.displayed_panels.includes(panelId);
              checkbox.checked = isVisible;
            });
          }
          
          // Применяем макет, если он есть в настройках
          if (settings.layout && settings.layout.rows) {
            applyLayout(settings.layout);
            return; // Успешно загрузили, выходим
          }
        }
        
        // Если нет полных настроек, пробуем загрузить только макет
        if (savedLayout) {
          console.log('Загружаем сохраненный макет из localStorage');
          const layoutData = JSON.parse(savedLayout);
          applyLayout(layoutData);
        }
      } catch (e) {
        console.error('Ошибка при загрузке макета:', e);
      }
      
      // Пробуем загрузить с сервера, если локальные данные не найдены или некорректны
      if (!savedLayout && !savedSettings) {
        console.log('Пытаемся загрузить настройки с сервера');
        fetchSettingsFromServer();
      } else {
        // Применяем видимость панелей после загрузки макета
        // Это нужно, чтобы убедиться, что все панели правильно отображаются
        setTimeout(() => {
          updatePanelsVisibility();
        }, 200);
      }
    }
    
    // Применяет текущие настройки видимости из чекбоксов к панелям
    function updatePanelsVisibility() {
      document.querySelectorAll('.panel-toggle').forEach(checkbox => {
        const panelId = checkbox.dataset.panel;
        const isVisible = checkbox.checked;
        
        // Применяем видимость к панелям
        document.querySelectorAll(`.grid-panel[data-panel="${panelId}"]`).forEach(panel => {
          panel.style.display = isVisible ? 'block' : 'none';
        });
      });
      
      // Проверяем пустые ряды и все отключенные панели
      checkEmptyRows();
      checkAllPanelsDisabled();
    }
    
    // Функция для загрузки настроек с сервера
    function fetchSettingsFromServer() {
      fetch('/dashboard/settings')
        .then(response => {
          if (!response.ok) {
            throw new Error('Не удалось загрузить настройки с сервера');
          }
          return response.json();
        })
        .then(data => {
          console.log('Настройки загружены с сервера:', data);
          if (data.settings) {
            // Сохраняем в localStorage для будущего использования
            localStorage.setItem('dashboardSettings', JSON.stringify(data.settings));
            
            // Применяем загруженные настройки
            if (data.settings.layout) {
              applyLayout(data.settings.layout);
            }
          }
        })
        .catch(error => {
          console.error('Ошибка при загрузке настроек с сервера:', error);
        });
    }
    
    // Функция для применения сохраненного макета
    function applyLayout(layoutData) {
      console.log('Применяем макет:', layoutData);
      
      if (!layoutData || !layoutData.rows || !Array.isArray(layoutData.rows)) {
        console.error('Некорректные данные макета:', layoutData);
        return;
      }
      
      // Получаем основной контейнер для сетки
      const gridContainer = document.getElementById('metrics-grid');
      
      if (!gridContainer) {
        console.error('Не найден контейнер с id "metrics-grid"');
        return;
      }
      
      // Сохраняем все оригинальные панели по их data-panel, а не по id
      const originalPanels = {};
      document.querySelectorAll('.grid-panel').forEach(panel => {
        const panelType = panel.dataset.panel;
        if (panelType) {
          originalPanels[panelType] = panel.cloneNode(true);
        }
      });
      
      // Очищаем текущий контейнер
      gridContainer.innerHTML = '';
      
      // Воссоздаем структуру строк и панелей на основе сохраненных данных
      layoutData.rows.forEach((rowData, rowIndex) => {
        // Создаем новую строку
        const rowEl = document.createElement('div');
        rowEl.className = 'grid-row';
        rowEl.id = `row-${rowIndex + 1}`;
        rowEl.dataset.row = rowIndex;
        
        // Добавляем панели в строку
        rowData.panels.forEach(panelData => {
          // Получаем существующую панель или создаем заглушку
          let panelEl;
          
          // Пытаемся найти оригинальную панель по data-panel атрибуту
          const panelType = panelData.dataPanel;
          
          if (panelType && originalPanels[panelType]) {
            // Используем клон оригинальной панели
            panelEl = originalPanels[panelType].cloneNode(true);
            
            // Убеждаемся, что id соответствует панели
            if (panelData.id) {
              panelEl.id = panelData.id;
            }
            
            // Применяем видимость, используя style.display для согласованности
            if (panelData.hasOwnProperty('visible')) {
              panelEl.style.display = panelData.visible ? 'block' : 'none';
            }
          } else {
            // Создаем заглушку, если панель не найдена
            console.warn(`Панель с типом ${panelType} не найдена`);
            panelEl = createSamplePanel(panelType);
          }
          
          // Добавляем панель в строку
          rowEl.appendChild(panelEl);
        });
        
        // Добавляем строку в контейнер
        gridContainer.appendChild(rowEl);
      });
      
      // Повторно инициализируем drag-and-drop функциональность
      setupDragAndDrop();
      
      // Повторно подключаем обработчики событий для кнопок и функций
      setupPanelInteractions();
      
      // Проверяем пустые ряды и скрытые панели
      checkEmptyRows();
      checkAllPanelsDisabled();
      
      // Обновляем графики, если они есть
      try {
        createDemoData();
      } catch (e) {
        console.error('Ошибка при рендеринге графиков после применения макета:', e);
      }
      
      console.log('Макет успешно применен');
    }
    
    // Функция для настройки интерактивности панелей после загрузки макета
    function setupPanelInteractions() {
      // Настраиваем кнопки полноэкранного режима
      document.querySelectorAll('.panel-fullscreen').forEach(button => {
        if (!button.hasEventListener) {
          button.addEventListener('click', toggleFullscreen);
          button.hasEventListener = true;
        }
      });
    }
    
    // Функции для автообновления
    let refreshInterval;
    
    function startAutoRefresh() {
      refreshInterval = setInterval(function() {
        updateAllMetrics();
      }, 30000); // Обновление каждые 30 секунд
    }
    
    function stopAutoRefresh() {
      clearInterval(refreshInterval);
    }
    
    function updateAllMetrics() {
      console.log('Обновляем все метрики...');
      // Здесь будет код для обновления всех метрик
    }
    
    function updateMetricsData(timeRange) {
      console.log('Запрашиваем новые данные для временного диапазона:', timeRange);
      // Здесь будет код для запроса и обновления данных метрик
    }
    
    // Функция для создания заглушки панели по типу
    function createSamplePanel(panelType) {
      const panelEl = document.createElement('div');
      panelEl.className = `grid-panel panel ${panelType}`;
      panelEl.dataset.panel = panelType;
      panelEl.id = `panel-${panelType}`;
      
      // Заголовок панели
      const panelName = {
        'service-health': 'Состояние сервисов',
        'response-time': 'Время отклика',
        'throughput': 'Пропускная способность',
        'error-rate': 'Уровень ошибок',
        'resource-usage': 'Использование ресурсов'
      }[panelType] || 'Неизвестная панель';
      
      // Создаем шаблон панели с пустым контейнером для графика
      panelEl.innerHTML = `
        <div class="panel-header">
          <h2>${panelName}</h2>
          <div class="panel-header-actions">
            <button class="panel-fullscreen" title="На весь экран"><i class="fa fa-expand"></i></button>
          </div>
        </div>
        
        ${panelType === 'resource-usage' ? `
          <div class="resource-usage-container">
            <div id="resource-usage-chart" class="chart-container">
              <canvas id="resource-usage-canvas" width="400" height="200"></canvas>
            </div>
            <div id="cpu-usage-chart" class="chart-container">
              <canvas id="cpu-usage-canvas" width="400" height="200"></canvas>
            </div>
            <div id="memory-usage-chart" class="chart-container">
              <canvas id="memory-usage-canvas" width="400" height="200"></canvas>
            </div>
          </div>
        ` : `
          <div id="${panelType}-chart" class="chart-container">
            <canvas id="${panelType}-canvas" width="400" height="200"></canvas>
          </div>
        `}
      `;
      
      return panelEl;
    }
  </script>
<% end %> 


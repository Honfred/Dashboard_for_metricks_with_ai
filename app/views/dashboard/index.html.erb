<div class="dashboard-container">
  <h1>Мониторинг производительности</h1>
  
  <div class="dashboard-controls">
    <div class="time-selector">
      <label for="time-range">Временной интервал:</label>
      <select id="time-range">
        <option value="15m" <%= @settings[:time_range] == '15m' ? 'selected' : '' %>>15 минут</option>
        <option value="1h" <%= @settings[:time_range] == '1h' ? 'selected' : '' %>>1 час</option>
        <option value="3h" <%= @settings[:time_range] == '3h' ? 'selected' : '' %>>3 часа</option>
        <option value="6h" <%= @settings[:time_range] == '6h' ? 'selected' : '' %>>6 часов</option>
        <option value="12h" <%= @settings[:time_range] == '12h' ? 'selected' : '' %>>12 часов</option>
        <option value="24h" <%= @settings[:time_range] == '24h' ? 'selected' : '' %>>24 часа</option>
        <option value="7d" <%= @settings[:time_range] == '7d' ? 'selected' : '' %>>7 дней</option>
      </select>
    </div>
    
    <div class="refresh-control">
      <label for="auto-refresh">Автообновление:</label>
      <select id="auto-refresh">
        <option value="off" <%= @settings[:refresh_interval] == 'off' ? 'selected' : '' %>>Выключено</option>
        <option value="10s" <%= @settings[:refresh_interval] == '10s' ? 'selected' : '' %>>10 секунд</option>
        <option value="30s" <%= @settings[:refresh_interval] == '30s' ? 'selected' : '' %>>30 секунд</option>
        <option value="1m" <%= @settings[:refresh_interval] == '1m' ? 'selected' : '' %>>1 минута</option>
        <option value="5m" <%= @settings[:refresh_interval] == '5m' ? 'selected' : '' %>>5 минут</option>
      </select>
    </div>
    
    <div class="dashboard-actions">
      <button id="save-layout" class="btn btn-primary">Сохранить настройки</button>
      <button id="toggle-edit-mode" class="btn btn-primary">
        <i class="fas fa-edit"></i> Режим редактирования
      </button>
      <button id="show-all-panels" class="btn btn-success">
        <i class="fas fa-eye"></i> Показать все панели
      </button>
      <div id="panel-visibility" class="panel-visibility-dropdown">
        <button class="btn btn-secondary dropdown-toggle">Видимость панелей</button>
        <div class="dropdown-content">
          <% ['service-health', 'response-time', 'throughput', 'error-rate', 'resource-usage'].each do |panel| %>
            <label>
              <input type="checkbox" class="panel-toggle" data-panel="<%= panel %>" 
                <%= @settings[:displayed_panels].include?(panel) ? 'checked' : '' %>>
              <%= { 
                'service-health' => 'Состояние сервисов', 
                'response-time' => 'Время отклика', 
                'throughput' => 'Пропускная способность', 
                'error-rate' => 'Уровень ошибок', 
                'resource-usage' => 'Использование ресурсов' 
              }[panel] %>
            </label>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div id="metrics-grid" class="metrics-grid">
    <% @settings[:layout][:rows].each_with_index do |row, row_index| %>
      <div class="grid-row" data-row="<%= row_index %>">
        <% row[:panels].each do |panel| %>
          <% display = @settings[:displayed_panels].include?(panel) ? '' : 'display: none;' %>
          <div class="grid-panel panel <%= panel %>" data-panel="<%= panel %>" style="<%= display %>">
            <div class="panel-header">
              <h2><%= { 
                'service-health' => 'Состояние сервисов', 
                'response-time' => 'Время отклика', 
                'throughput' => 'Пропускная способность', 
                'error-rate' => 'Уровень ошибок', 
                'resource-usage' => 'Использование ресурсов' 
              }[panel] %></h2>
              <div class="panel-header-actions">
                <button class="panel-fullscreen" title="На весь экран"><i class="fa fa-expand"></i></button>
              </div>
            </div>
            <% if panel == 'resource-usage' %>
              <div class="resource-usage-container">
                <div id="resource-usage-chart" class="chart-container">
                  <canvas id="resource-usage-canvas" width="400" height="200"></canvas>
                </div>
                <div id="cpu-usage-chart" class="chart-container">
                  <canvas id="cpu-usage-canvas" width="400" height="200"></canvas>
                </div>
                <div id="memory-usage-chart" class="chart-container">
                  <canvas id="memory-usage-canvas" width="400" height="200"></canvas>
                </div>
              </div>
            <% else %>
              <div id="<%= panel %>-chart" class="chart-container">
                <canvas id="<%= panel %>-canvas" width="400" height="200"></canvas>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
  
  <!-- Модальное окно с оповещениями -->
  <div id="alerts-modal" class="modal">
    <div class="modal-content">
      <div class="modal-header">
        <h2>Оповещения</h2>
        <span class="close">&times;</span>
      </div>
      <div class="modal-body">
        <div id="alerts-list">
          <!-- Здесь будут отображаться активные оповещения -->
        </div>
      </div>
    </div>
  </div>
</div>

<% content_for :scripts do %>
  <!-- Подключаем библиотеки Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns@2.0.0/dist/chartjs-adapter-date-fns.bundle.min.js"></script>
  
  <!-- Импортируем модули JavaScript для дашборда -->
  <%= javascript_import_module_tag "dashboard" %>
<% end %> 

<% content_for :styles do %>
  <style>
    .dashboard-container {
      padding: 20px;
    }
    
    .dashboard-controls {
      display: flex;
      justify-content: space-between;
      margin-bottom: 20px;
      padding: 10px;
      background-color: #f8f9fa;
      border-radius: 5px;
    }
    
    .dashboard-actions {
      display: flex;
      gap: 10px;
    }
    
    .metrics-grid {
      display: flex;
      flex-direction: column;
      gap: 15px;
    }
    
    .grid-row {
      display: flex;
      gap: 15px;
      min-height: 350px; /* Увеличиваем минимальную высоту строки */
    }
    
    .grid-panel {
      flex: 1;
      background: white;
      border-radius: 5px;
      box-shadow: 0 2px 5px rgba(0,0,0,0.1);
      padding: 15px;
      position: relative;
      display: flex;
      flex-direction: column;
      min-height: 350px; /* Добавляем минимальную высоту для панелей */
    }
    
    .panel-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 8px 12px;
      background-color: #f8f9fa;
      border-bottom: 1px solid #e9ecef;
      margin-bottom: 10px;
      border-radius: 4px 4px 0 0;
      flex-shrink: 0; /* Запрещаем сжиматься заголовку */
    }
    
    .panel-header h2 {
      margin: 0;
      font-size: 16px;
      font-weight: 500;
      color: #495057;
      text-overflow: ellipsis;
      overflow: hidden;
      white-space: nowrap;
    }
    
    .panel-header-actions {
      display: flex;
      align-items: center;
      gap: 5px;
    }
    
    .panel-actions {
      display: flex;
      gap: 5px;
    }
    
    .chart-container {
      flex: 1;
      min-height: 250px; /* Увеличиваем минимальную высоту контейнера графика */
      display: flex;
      align-items: center;
      justify-content: center;
      background-color: #f9f9f9;
      border-radius: 4px;
      margin-top: 5px;
      border: 1px solid #eee;
      overflow: hidden; /* Предотвращаем выход контента за границы */
    }
    
    .chart-container canvas {
      width: 100% !important;
      height: 100% !important;
      max-width: 100%;
      max-height: 100%;
    }
    
    .edit-mode .grid-panel {
      border: 2px dashed #3498db;
      transition: all 0.3s ease;
      position: relative;
      cursor: move !important;
    }
    
    .edit-mode .grid-panel:hover {
      transform: translateY(-2px);
      box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
    }
    
    .edit-mode .grid-panel::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-color: rgba(52, 152, 219, 0.05);
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.3s ease;
      z-index: 1;
    }
    
    .edit-mode .grid-panel:hover::before {
      opacity: 1;
    }
    
    .sortable-ghost {
      opacity: 0.4 !important;
      background-color: #f0f0f0 !important;
      border: 2px dashed #ccc !important;
      box-shadow: none !important;
      transform: none !important;
    }
    
    .sortable-chosen {
      background-color: #fff !important;
      z-index: 1100 !important;
      box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2) !important;
    }
    
    .sortable-drag {
      opacity: 0.9 !important;
      background-color: #fff !important;
      transform: rotate(1deg) scale(1.02) !important;
      box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2) !important;
      z-index: 1200 !important;
    }

    .being-dragged {
      cursor: grabbing !important;
      cursor: -webkit-grabbing !important;
    }

    .dragging-active .grid-panel:not(.being-dragged):not(.sortable-ghost) {
      transition: transform 0.2s ease;
    }

    .dragging-active .grid-panel:not(.being-dragged):not(.sortable-ghost):hover {
      transform: translateY(5px);
    }
    
    .panel-header-actions button {
      background: none;
      border: none;
      color: #6c757d;
      cursor: pointer;
      padding: 5px;
      font-size: 14px;
      transition: color 0.2s;
    }
    
    .panel-header-actions button:hover {
      color: #3498db;
    }
    
    .panel-fullscreen {
      background: none;
      border: none;
      color: #6c757d;
      padding: 5px 8px;
      border-radius: 3px;
      transition: background-color 0.2s;
    }
    
    .panel-fullscreen:hover {
      background-color: #f0f0f0;
    }
    
    .fullscreen {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100vh; /* Используем viewport height */
      z-index: 9999;
      background-color: white;
      padding: 20px;
      box-sizing: border-box;
      background-color: white;
    }
    
    .panel-visibility-dropdown {
      position: relative;
      display: inline-block;
    }
    
    .dropdown-content {
      display: none;
      position: absolute;
      background-color: #f9f9f9;
      min-width: 200px;
      box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.2);
      z-index: 1;
      padding: 10px;
      border-radius: 5px;
      right: 0;
    }
    
    .panel-visibility-dropdown:hover .dropdown-content {
      display: block;
    }
    
    .dropdown-content label {
      display: block;
      padding: 8px 5px;
      cursor: pointer;
      transition: background-color 0.2s;
    }
    
    .dropdown-content label:hover {
      background-color: #f0f0f0;
    }
    
    .dropdown-toggle {
      display: flex;
      align-items: center;
      gap: 5px;
    }
    
    .dropdown-toggle::after {
      content: "";
      display: inline-block;
      margin-left: 5px;
      vertical-align: middle;
      border-top: 4px solid;
      border-right: 4px solid transparent;
      border-left: 4px solid transparent;
    }
    
    /* Улучшенные стили для кнопок */
    .btn {
      padding: 8px 15px;
      border-radius: 4px;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
    }
    
    .btn-primary {
      background-color: #3498db;
      color: white;
      border: 1px solid #2980b9;
    }
    
    .btn-primary:hover {
      background-color: #2980b9;
      border-color: #2573a7;
    }
    
    .btn-secondary {
      background-color: #f8f9fa;
      color: #495057;
      border: 1px solid #ced4da;
    }
    
    .btn-secondary:hover {
      background-color: #e9ecef;
      border-color: #ced4da;
    }
    
    .btn-outline-primary {
      background-color: transparent;
      color: #3498db;
      border: 1px solid #3498db;
    }
    
    .btn-outline-primary:hover {
      background-color: #3498db;
      color: white;
    }
    
    /* Сообщение при отсутствии видимых панелей */
    .no-panels-message {
      width: 100%;
      margin-top: 20px;
    }
    
    .no-panels-message .alert {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 20px;
      text-align: center;
    }
    
    .no-panels-message .fa-info-circle {
      font-size: 32px;
      margin-bottom: 15px;
      color: #17a2b8;
    }
    
    .no-panels-message p {
      margin-bottom: 15px;
      font-size: 16px;
    }
    
    /* Стили для модального окна с оповещениями */
    .modal {
      display: none;
      position: fixed;
      z-index: 2000;
      left: 0;
      top: 0;
      width: 100%;
      height: 100%;
      overflow: auto;
      background-color: rgba(0,0,0,0.4);
    }
    
    .modal-content {
      background-color: white;
      margin: 10% auto;
      padding: 20px;
      border-radius: 5px;
      width: 60%;
      max-width: 600px;
    }
    
    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 15px;
    }
    
    .close {
      color: #aaa;
      font-size: 28px;
      font-weight: bold;
      cursor: pointer;
    }
    
    .close:hover {
      color: #000;
    }
    
    .alert {
      padding: 15px;
      margin-bottom: 10px;
      border-radius: 5px;
    }
    
    .alert-warning {
      background-color: #fff3cd;
      border: 1px solid #ffecb5;
    }
    
    .alert-critical {
      background-color: #f8d7da;
      border: 1px solid #f5c2c7;
    }
    
    .alert-info {
      background-color: #d1ecf1;
      border: 1px solid #bee5eb;
      color: #0c5460;
    }
    
    /* Стили для полноэкранного режима */
    .grid-panel.fullscreen {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      width: 100%;
      height: 100vh; /* Используем viewport height */
      z-index: 9999;
      background-color: white;
      padding: 20px;
      box-shadow: 0 0 30px rgba(0, 0, 0, 0.2);
      margin: 0;
      overflow: auto;
      display: flex;
      flex-direction: column;
    }
    
    .grid-panel.fullscreen .chart-container {
      flex: 1;
      height: calc(100vh - 100px); /* Динамически вычисляем высоту */
      min-height: 500px; /* Минимальная высота для полноэкранного режима */
      max-height: none; /* Убираем ограничения на максимальную высоту */
    }
    
    .grid-panel.fullscreen .panel-header {
      margin-bottom: 15px;
    }
    
    /* Увеличиваем размер для service-health в полноэкранном режиме */
    .grid-panel.fullscreen.service-health .chart-container {
      padding: 20px;
      overflow-y: auto;
    }
    
    .grid-panel.fullscreen .status-table {
      width: 100%;
      max-width: 1200px; /* Ограничиваем максимальную ширину для удобства чтения */
      margin: 0 auto; /* Центрируем таблицу */
    }
    
    .grid-panel.fullscreen .status-table th,
    .grid-panel.fullscreen .status-table td {
      padding: 12px 15px; /* Увеличиваем отступы в полноэкранном режиме */
      font-size: 16px; /* Увеличиваем размер шрифта */
    }
    
    /* Стили для таблицы статусов сервисов */
    .status-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 10px;
    }
    
    /* Специальные стили для панели состояния сервисов */
    .service-health .chart-container {
      overflow-y: auto; /* Добавляем прокрутку для таблицы сервисов */
      display: block; /* Изменяем отображение для правильного размещения таблицы */
      padding: 10px;
    }
    
    .service-health .status-table {
      width: 100%;
      table-layout: fixed; /* Фиксированная ширина столбцов */
    }
    
    .service-health .status-table th, 
    .service-health .status-table td {
      padding: 10px 8px; /* Уменьшаем немного отступы */
      white-space: nowrap; /* Запрещаем перенос текста */
      overflow: hidden;
      text-overflow: ellipsis; /* Добавляем многоточие для переполненного текста */
    }
    
    .status-table th, 
    .status-table td {
      padding: 10px;
      text-align: left;
      border-bottom: 1px solid #e9ecef;
    }
    
    .status-table th {
      background-color: #f8f9fa;
      font-weight: 600;
      color: #495057;
    }
    
    .status-up {
      color: #28a745;
      display: flex;
      align-items: center;
    }
    
    .status-up::before {
      content: '';
      display: inline-block;
      width: 10px;
      height: 10px;
      background-color: #28a745;
      border-radius: 50%;
      margin-right: 8px;
    }
    
    .status-down {
      color: #dc3545;
      display: flex;
      align-items: center;
    }
    
    .status-down::before {
      content: '';
      display: inline-block;
      width: 10px;
      height: 10px;
      background-color: #dc3545;
      border-radius: 50%;
      margin-right: 8px;
    }
    
    /* Стили для выделения выбранного сервиса в таблице */
    .service-row.selected {
      background-color: rgba(52, 152, 219, 0.1);
    }
    
    /* Подсветка строки сервиса при наведении */
    .service-row {
      cursor: pointer;
      transition: background-color 0.2s;
    }
    
    .service-row:hover {
      background-color: rgba(52, 152, 219, 0.05);
    }
    
    /* Стили для индикатора выбранного сервиса */
    .selected-service-indicator {
      position: absolute;
      top: 10px;
      right: 10px;
      padding: 3px 8px;
      background: #3498db;
      color: white;
      border-radius: 10px;
      font-size: 12px;
      font-weight: 500;
      display: none;
    }
    
    .grid-panel:has(.selected-service-indicator) .panel-header {
      border-top: 2px solid #3498db;
    }
  </style>
<% end %> 

<% content_for :head do %>
  <!-- Загружаем библиотеки Sortable для перетаскивания элементов -->
  <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
<% end %>
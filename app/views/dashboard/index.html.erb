<div class="dashboard-container">
  <h1><%= t('dashboard.title') %></h1>
  
  <div class="dashboard-controls">
    <div class="time-selector">
      <label for="time-range"><%= t('dashboard.time_range.label') %></label>
      <select id="time-range">
        <option value="15m" <%= @settings[:time_range] == '15m' ? 'selected' : '' %>><%= t('dashboard.time_range.15m') %></option>
        <option value="1h" <%= @settings[:time_range] == '1h' ? 'selected' : '' %>><%= t('dashboard.time_range.1h') %></option>
        <option value="3h" <%= @settings[:time_range] == '3h' ? 'selected' : '' %>><%= t('dashboard.time_range.3h') %></option>
        <option value="6h" <%= @settings[:time_range] == '6h' ? 'selected' : '' %>><%= t('dashboard.time_range.6h') %></option>
        <option value="12h" <%= @settings[:time_range] == '12h' ? 'selected' : '' %>><%= t('dashboard.time_range.12h') %></option>
        <option value="24h" <%= @settings[:time_range] == '24h' ? 'selected' : '' %>><%= t('dashboard.time_range.24h') %></option>
        <option value="7d" <%= @settings[:time_range] == '7d' ? 'selected' : '' %>><%= t('dashboard.time_range.7d') %></option>
      </select>
    </div>
    
    <div class="refresh-control">
      <label for="auto-refresh"><%= t('dashboard.auto_refresh.label') %></label>
      <select id="auto-refresh">
        <option value="off" <%= @settings[:refresh_interval] == 'off' ? 'selected' : '' %>><%= t('dashboard.auto_refresh.off') %></option>
        <option value="10s" <%= @settings[:refresh_interval] == '10s' ? 'selected' : '' %>><%= t('dashboard.auto_refresh.10s') %></option>
        <option value="30s" <%= @settings[:refresh_interval] == '30s' ? 'selected' : '' %>><%= t('dashboard.auto_refresh.30s') %></option>
        <option value="1m" <%= @settings[:refresh_interval] == '1m' ? 'selected' : '' %>><%= t('dashboard.auto_refresh.1m') %></option>
        <option value="5m" <%= @settings[:refresh_interval] == '5m' ? 'selected' : '' %>><%= t('dashboard.auto_refresh.5m') %></option>
      </select>
    </div>
    
    <div class="dashboard-actions">
      <button id="save-layout" class="btn btn-primary"><%= t('dashboard.save_settings') %></button>
      <button id="toggle-edit-mode" class="btn btn-primary">
        <i class="fas fa-edit"></i> <%= t('dashboard.edit_mode') %>
      </button>
      <button id="show-all-panels" class="btn btn-success">
        <i class="fas fa-eye"></i> <%= t('dashboard.show_all_panels') %>
      </button>
      <div id="panel-visibility" class="panel-visibility-dropdown">
        <button class="btn btn-secondary dropdown-toggle"><%= t('dashboard.panel_visibility') %></button>
        <div class="dropdown-content">
          <% ['service-health', 'response-time', 'throughput', 'error-rate', 'resource-usage'].each do |panel| %>
            <label>
              <input type="checkbox" class="panel-toggle" data-panel="<%= panel %>" 
                <%= @settings[:displayed_panels].include?(panel) ? 'checked' : '' %>>
              <%= t("dashboard.panels.#{panel.gsub('-', '_')}") %>
            </label>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div id="metrics-grid" class="metrics-grid">
    <% @settings[:layout][:rows].each_with_index do |row, row_index| %>
      <div class="grid-row" data-row="<%= row_index %>">
        <% row[:panels].each do |panel| %>
          <% panel_class = @settings[:displayed_panels].include?(panel) ? '' : 'panel-hidden' %>
          <div class="grid-panel panel <%= panel %> <%= panel_class %>" data-panel="<%= panel %>">
            <div class="panel-header">
              <h2><%= t("dashboard.panels.#{panel.gsub('-', '_')}") %></h2>
              <div class="panel-header-actions">
                <button class="panel-fullscreen" title="<%= t('dashboard.fullscreen') %>"><i class="fa fa-expand"></i></button>
              </div>
            </div>
            <% if panel == 'resource-usage' %>
              <div class="resource-usage-container">
                <div id="resource-usage-chart" class="chart-container">
                  <canvas id="resource-usage-canvas" width="400" height="200"></canvas>
                </div>
                <div id="cpu-usage-chart" class="chart-container">
                  <canvas id="cpu-usage-canvas" width="400" height="200"></canvas>
                </div>
                <div id="memory-usage-chart" class="chart-container">
                  <canvas id="memory-usage-canvas" width="400" height="200"></canvas>
                </div>
              </div>
            <% else %>
              <div id="<%= panel %>-chart" class="chart-container">
                <canvas id="<%= panel %>-canvas" width="400" height="200"></canvas>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
  
  <!-- Модальное окно с оповещениями -->
  <div id="alerts-modal" class="modal">
    <div class="modal-content">
      <div class="modal-header">
        <h2><%= t('dashboard.alerts_modal_title') %></h2>
        <span class="close">&times;</span>
      </div>
      <div class="modal-body">
        <div id="alerts-list">
          <!-- Здесь будут отображаться активные оповещения -->
        </div>
      </div>
    </div>
  </div>
</div>

<% content_for :scripts do %>
  <!-- Адаптер дат для оси времени (сам Chart.js подключается в layout) -->
  <script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns@2.0.0/dist/chartjs-adapter-date-fns.bundle.min.js"></script>
  
  <!-- Переводы для графиков и сообщений -->
  <script>
    window.dashboardTranslations = {
      charts: {
        responseTime: "<%= j t('dashboard.charts.response_time') %>",
        throughput: "<%= j t('dashboard.charts.throughput') %>",
        errorRate: "<%= j t('dashboard.charts.error_rate') %>",
        resourceUsage: "<%= j t('dashboard.charts.resource_usage') %>",
        cpuUsage: "<%= j t('dashboard.charts.cpu_usage') %>",
        memoryUsage: "<%= j t('dashboard.charts.memory_usage') %>"
      },
      messages: {
        settingsSaved: "<%= j t('dashboard.messages.settings_saved') %>",
        settingsSavedLocally: "<%= j t('dashboard.messages.settings_saved_locally') %>",
        chartLoadingError: "<%= j t('dashboard.messages.chart_loading_error') %>",
        chartCreationError: "<%= j t('dashboard.messages.chart_creation_error') %>",
        canvasNotFound: "<%= j t('dashboard.messages.canvas_not_found') %>",
        chartError: "<%= j t('dashboard.messages.chart_error') %>",
        initError: "<%= j t('dashboard.messages.init_error') %>",
        refreshPage: "<%= j t('dashboard.messages.refresh_page') %>"
      },
      editMode: {
        start: "<%= j t('dashboard.edit_mode_start') %>",
        finish: "<%= j t('dashboard.edit_mode_finish') %>"
      },
      serviceHealth: {
        service: "<%= j t('dashboard.service_health_table.service') %>",
        status: "<%= j t('dashboard.service_health_table.status') %>",
        uptime: "<%= j t('dashboard.service_health_table.uptime') %>",
        statusUp: "<%= j t('dashboard.service_health_table.status_up') %>",
        statusDown: "<%= j t('dashboard.service_health_table.status_down') %>"
      },
      alertsWidget: {
        noActiveAlerts: "<%= j t('dashboard.alerts_widget.no_active_alerts') %>",
        metricLabel: "<%= j t('dashboard.alerts_widget.metric_label') %>",
        valueLabel: "<%= j t('dashboard.alerts_widget.value_label') %>",
        thresholdLabel: "<%= j t('dashboard.alerts_widget.threshold_label') %>",
        timeLabel: "<%= j t('dashboard.alerts_widget.time_label') %>"
      },
      timeAxis: "<%= j t('dashboard.time_axis') %>",
      serviceLabel: "<%= j t('dashboard.service_label') %>",
      timeLabel: "<%= j t('dashboard.time_label') %>"
    };
  </script>
  
  <!-- Импортируем модули JavaScript для дашборда -->
  <%= javascript_import_module_tag "dashboard" %>
<% end %> 

<% content_for :head do %>
  <!-- Загружаем библиотеки Sortable для перетаскивания элементов -->
  <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
  <%= stylesheet_link_tag "dashboard" %>
<% end %>
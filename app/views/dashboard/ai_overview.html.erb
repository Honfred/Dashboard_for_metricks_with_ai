<% content_for :head do %>
  <%= stylesheet_link_tag "ai_analysis" %>
<% end %>

<div class="container-fluid mt-4">
  <h2 class="mb-4"><%= t('ai_analysis.title') %></h2>
  
  <div class="row mb-4">
    <div class="col-md-12">
      <div class="card">
        <div class="card-header bg-primary text-white">
          <h5 class="mb-0"><%= t('ai_analysis.overview_title') %></h5>
        </div>
        <div class="card-body">
          <div class="row">
            <!-- Аномалии -->
            <div class="col-md-4">
              <div class="card">
                <div class="card-header bg-danger text-white">
                  <h5 class="mb-0"><%= t('ai_analysis.models.anomaly_detection.title') %></h5>
                </div>
                <div class="card-body text-center">
                  <div class="display-4 mb-3">
                    <% anomaly_count = AiAnalysis.where(analysis_type: :anomaly_detection).select(&:completed?).count %>
                    <%= anomaly_count %>
                  </div>
                  <p><%= t('ai_analysis.completed_analyses') %></p>
                  <hr>
                  <p>
                    <small><%= t('ai_analysis.models.anomaly_detection.description') %></small>
                  </p>
                  <%= link_to t('ai_analysis.view_all'), ai_analyses_path(type: 'anomaly_detection'), class: 'btn btn-outline-danger' %>
                </div>
              </div>
            </div>
            
            <!-- Тренды -->
            <div class="col-md-4">
              <div class="card">
                <div class="card-header bg-warning text-dark">
                  <h5 class="mb-0"><%= t('ai_analysis.models.trend_prediction.title') %></h5>
                </div>
                <div class="card-body text-center">
                  <div class="display-4 mb-3">
                    <% trend_count = AiAnalysis.where(analysis_type: :trend_prediction).select(&:completed?).count %>
                    <%= trend_count %>
                  </div>
                  <p><%= t('ai_analysis.completed_analyses') %></p>
                  <hr>
                  <p>
                    <small><%= t('ai_analysis.models.trend_prediction.description') %></small>
                  </p>
                  <%= link_to t('ai_analysis.view_all'), ai_analyses_path(type: 'trend_prediction'), class: 'btn btn-outline-warning' %>
                </div>
              </div>
            </div>
            
            <!-- Производительность -->
            <div class="col-md-4">
              <div class="card">
                <div class="card-header bg-info text-white">
                  <h5 class="mb-0"><%= t('ai_analysis.models.performance_insight.title') %></h5>
                </div>
                <div class="card-body text-center">
                  <div class="display-4 mb-3">
                    <% perf_count = AiAnalysis.where(analysis_type: :performance_insight).select(&:completed?).count %>
                    <%= perf_count %>
                  </div>
                  <p><%= t('ai_analysis.completed_analyses') %></p>
                  <hr>
                  <p>
                    <small><%= t('ai_analysis.models.performance_insight.description') %></small>
                  </p>
                  <%= link_to t('ai_analysis.view_all'), ai_analyses_path(type: 'performance_insight'), class: 'btn btn-outline-info' %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <div class="row mb-4">
    <div class="col-md-6">
      <div class="card">
        <div class="card-header bg-primary text-white">
          <h5 class="mb-0"><%= t('ai_analysis.recent_anomalies') %></h5>
        </div>
        <div class="card-body">
          <div id="recent-anomalies-chart" class="analysis-chart-container"></div>
          <hr>
          <div class="table-responsive">
            <table class="table table-sm table-hover">
              <thead>
                <tr>
                  <th><%= t('ai_analysis.anomaly.metric') %></th>
                  <th><%= t('ai_analysis.anomaly.detection_time') %></th>
                  <th><%= t('ai_analysis.anomaly.deviation') %></th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% recent_anomalies = AiAnalysis.where(analysis_type: 'anomaly_detection', status: 'completed')
                                   .order(created_at: :desc).limit(5) %>
                <% recent_anomalies.each do |analysis| %>
                  <% if analysis.report.present? && analysis.report["events"].present? %>
                    <% event = analysis.report["events"].first %>
                    <tr>
                      <td><%= analysis.metric.name %></td>
                      <td><%= analysis.completed_at ? l(analysis.completed_at, format: :default) : '-' %></td>
                      <td><span class="badge bg-danger"><%= event["deviation"] %>%</span></td>
                      <td><%= link_to t('common.more_details'), metric_ai_analysis_path(analysis.metric, analysis), class: 'btn btn-sm btn-outline-primary' %></td>
                    </tr>
                  <% end %>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-md-6">
      <div class="card">
        <div class="card-header bg-primary text-white">
          <h5 class="mb-0"><%= t('ai_analysis.trends_forecast') %></h5>
        </div>
        <div class="card-body">
          <div id="trends-forecast-chart" class="analysis-chart-container"></div>
          <hr>
          <div class="table-responsive">
            <table class="table table-sm table-hover">
              <thead>
                <tr>
                  <th><%= t('ai_analysis.trend.metric') %></th>
                  <th><%= t('ai_analysis.trend.forecast') %></th>
                  <th><%= t('ai_analysis.trend.change') %></th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% recent_trends = AiAnalysis.where(analysis_type: 'trend_prediction', status: 'completed')
                                  .order(created_at: :desc).limit(5) %>
                <% recent_trends.each do |analysis| %>
                  <% if analysis.report.present? && analysis.report["statistics"].present? %>
                    <tr>
                      <td><%= analysis.metric.name %></td>
                      <td><%= analysis.report["statistics"]["Среднее прогнозируемое значение"] %></td>
                      <td>
                        <% change = analysis.report["statistics"]["Изменение"] %>
                        <% if change.to_s.start_with?('+') %>
                          <span class="badge bg-success"><%= change %></span>
                        <% elsif change.to_s.start_with?('-') %>
                          <span class="badge bg-danger"><%= change %></span>
                        <% else %>
                          <span class="badge bg-secondary"><%= change %></span>
                        <% end %>
                      </td>
                      <td><%= link_to t('common.more_details'), metric_ai_analysis_path(analysis.metric, analysis), class: 'btn btn-sm btn-outline-primary' %></td>
                    </tr>
                  <% end %>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <div class="row">
    <div class="col-md-12">
      <div class="card">
        <div class="card-header bg-primary text-white">
          <h5 class="mb-0"><%= t('ai_analysis.run_new_analysis') %></h5>
        </div>
        <div class="card-body">
          <div class="row g-3" data-controller="ai-launcher">
            <div class="col-md-4">
              <label for="metric_select" class="form-label"><%= t('ai_analysis.select_metric') %></label>
              <select id="metric_select" class="form-select" data-ai-launcher-target="metric">
                <option value=""><%= t('ai_analysis.select_metric_prompt') %></option>
                <% Metric.all.each do |metric| %>
                  <option value="<%= metric.id %>"><%= metric.name %> (<%= metric.description %>)</option>
                <% end %>
              </select>
            </div>
            <div class="col-md-4">
              <label for="analysis_type" class="form-label"><%= t('ai_analysis.select_analysis_type') %></label>
              <select id="analysis_type" class="form-select" data-ai-launcher-target="analysisType">
                <option value=""><%= t('ai_analysis.select_analysis_type_prompt') %></option>
                <option value="anomaly_detection"><%= t('ai_analysis.models.anomaly_detection.title') %></option>
                <option value="trend_prediction"><%= t('ai_analysis.models.trend_prediction.title') %></option>
                <option value="performance_insight"><%= t('ai_analysis.models.performance_insight.title') %></option>
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label invisible"><%= t('common.actions') %></label>
              <div>
                <button data-action="click->ai-launcher#launch" class="btn btn-primary"><%= t('ai_analysis.run_analysis') %></button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
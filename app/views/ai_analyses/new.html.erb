<div class="container mt-4">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><%= link_to 'Метрики', metrics_path %></li>
      <li class="breadcrumb-item"><%= link_to @metric.name, metric_path(@metric) %></li>
      <li class="breadcrumb-item active" aria-current="page">Новый анализ</li>
    </ol>
  </nav>

  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card">
        <div class="card-header bg-primary text-white">
          <h5 class="mb-0">Новый ИИ-анализ для метрики: <%= @metric.name %></h5>
        </div>
        <div class="card-body">
          <%= form_with(model: [@metric, @ai_analysis], local: true) do |form| %>
            <% if @ai_analysis.errors.any? %>
              <div class="alert alert-danger">
                <h4><%= pluralize(@ai_analysis.errors.count, "ошибка") %> при сохранении анализа:</h4>
                <ul>
                  <% @ai_analysis.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="mb-3">
              <%= form.label :analysis_type, 'Тип анализа', class: 'form-label' %>
              <%= form.select :analysis_type, 
                  [
                    ['Обнаружение аномалий', 'anomaly_detection'],
                    ['Прогнозирование трендов', 'trend_prediction'],
                    ['Анализ производительности', 'performance_insight']
                  ], 
                  { selected: @ai_analysis.analysis_type }, 
                  class: 'form-select' %>
              <% if @ai_analysis.analysis_type.present? %>
                <div class="form-text text-success">
                  Выбран тип анализа: <%= @ai_analysis.analysis_type.humanize %>
                </div>
              <% end %>
            </div>

            <div class="mb-3">
              <%= form.label :parameters, 'Параметры анализа (JSON)', class: 'form-label' %>
              <%= form.text_area :parameters, rows: 5, class: 'form-control', placeholder: '{"window_size": 24, "sensitivity": 0.75}' %>
              <div class="form-text">
                Укажите дополнительные параметры для анализа в формате JSON. Оставьте пустым для использования параметров по умолчанию.
              </div>
            </div>

            <div class="d-flex justify-content-between">
              <%= link_to 'Отмена', metric_path(@metric), class: 'btn btn-secondary' %>
              <%= form.submit 'Запустить анализ', class: 'btn btn-success' %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
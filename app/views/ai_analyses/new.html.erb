<div class="container mt-4">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><%= link_to t('breadcrumbs.metrics'), metrics_path %></li>
      <li class="breadcrumb-item"><%= link_to @metric.name, metric_path(@metric) %></li>
      <li class="breadcrumb-item active" aria-current="page"><%= t('breadcrumbs.new_analysis') %></li>
    </ol>
  </nav>

  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card">
        <div class="card-header bg-primary text-white">
          <h5 class="mb-0"><%= t('ai_analysis.new_analysis_for_metric', name: @metric.name) %></h5>
        </div>
        <div class="card-body">
          <%= form_with(model: [@metric, @ai_analysis], local: true) do |form| %>
            <% if @ai_analysis.errors.any? %>
              <div class="alert alert-danger">
                <h4><%= t('ai_analysis.errors.saving', count: @ai_analysis.errors.count) %></h4>
                <ul>
                  <% @ai_analysis.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="mb-3">
              <%= form.label :analysis_type, t('ai_analysis.analysis_type_label'), class: 'form-label' %>
              <%= form.select :analysis_type, 
                  [
                    [t('ai_analysis.models.anomaly_detection.title'), 'anomaly_detection'],
                    [t('ai_analysis.models.trend_prediction.title'), 'trend_prediction'],
                    [t('ai_analysis.models.performance_insight.title'), 'performance_insight']
                  ], 
                  { selected: @ai_analysis.analysis_type }, 
                  class: 'form-select' %>
              <% if @ai_analysis.analysis_type.present? %>
                <div class="form-text text-success">
                  <%= t('ai_analysis.selected_type', type: @ai_analysis.analysis_type.humanize) %>
                </div>
              <% end %>
            </div>

            <div class="mb-3">
              <%= form.label :parameters, t('ai_analysis.parameters_label'), class: 'form-label' %>
              <%= form.text_area :parameters, rows: 5, class: 'form-control', placeholder: t('ai_analysis.parameters_placeholder') %>
              <div class="form-text">
                <%= t('ai_analysis.parameters_hint') %>
              </div>
            </div>

            <div class="d-flex justify-content-between">
              <%= link_to t('common.cancel'), metric_path(@metric), class: 'btn btn-secondary' %>
              <%= form.submit t('ai_analysis.run_analysis'), class: 'btn btn-success' %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
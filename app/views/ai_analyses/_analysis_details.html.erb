<% if analysis_type == 'anomaly_detection' %>
  <!-- Детали анализа аномалий -->
  <div class="card mb-4">
    <div class="card-header bg-danger text-white">
      <h5 class="mb-0"><%= t('ai_analysis.models.anomaly_detection.title') %></h5>
    </div>
    <div class="card-body">
      <div class="row">
        <div class="col-md-8">          
          <canvas id="anomaly-chart" width="800" height="250" 
                  style="border: 1px solid #ddd;">
            <%= t('ai_analysis.chart.browser_not_supported') %>
          </canvas>
          
          <script>
            // Простое создание графика без Stimulus
            document.addEventListener('DOMContentLoaded', function() {
              console.log('=== MANUAL CHART CREATION ===');
              
              const canvas = document.getElementById('anomaly-chart');
              if (!canvas) {
                console.error('Canvas not found');
                return;
              }
              
              // Проверяем загрузку Chart.js
              if (typeof Chart === 'undefined') {
                console.error('Chart.js not loaded');
                canvas.style.border = '2px solid red';
                return;
              }
              
              console.log('Chart.js loaded, creating chart...');
              
              // Получаем данные анализа
              const analysisData = <%= raw @analysis_data.to_json %>;
              console.log('Analysis data:', analysisData);
              
              const chartData = analysisData.chart_data;
              if (!chartData || !chartData.timestamps || !chartData.values) {
                console.error('Invalid chart data structure');
                canvas.style.border = '2px solid orange';
                return;
              }
              
              // Форматируем метки времени
              const labels = chartData.timestamps.map(ts => {
                const date = new Date(ts * 1000);
                return date.toLocaleString('<%= I18n.locale %>', { hour: '2-digit', minute: '2-digit', day: '2-digit', month: '2-digit' });
              });
              
              // Получаем данные аномалий
              const anomaliesMap = {};
              if (chartData.anomalies) {
                chartData.anomalies.forEach(a => {
                  anomaliesMap[a.timestamp] = a.value;
                });
              }
              
              // Создаем массивы данных для графика
              const normalData = [];
              const anomalyData = [];
              
              chartData.timestamps.forEach((ts, index) => {
                if (anomaliesMap[ts]) {
                  normalData.push(null);
                  anomalyData.push(chartData.values[index]);
                } else {
                  normalData.push(chartData.values[index]);
                  anomalyData.push(null);
                }
              });
              
              // Создаем график
              const ctx = canvas.getContext('2d');
              
              try {
                const chart = new Chart(ctx, {
                  type: 'line',
                  data: {
                    labels: labels,
                    datasets: [
                      {
                        label: '<%= t('ai_analysis.chart.normal_values') %>',
                        data: normalData,
                        borderColor: 'rgba(75, 192, 192, 1)',
                        tension: 0.1,
                        pointRadius: 3
                      },
                      {
                        label: '<%= t('ai_analysis.chart.anomalies') %>',
                        data: anomalyData,
                        borderColor: 'rgba(255, 99, 132, 1)',
                        backgroundColor: 'rgba(255, 99, 132, 0.2)',
                        tension: 0,
                        pointRadius: 6,
                        pointStyle: 'triangle'
                      }
                    ]
                  },
                  options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                      x: {
                        grid: {
                          display: false
                        }
                      }
                    },
                    plugins: {
                      tooltip: {
                        mode: 'index',
                        intersect: false
                      },
                      legend: {
                        position: 'top',
                      },
                      title: {
                        display: true,
                        text: '<%= t('ai_analysis.chart.anomaly_title') %>'
                      }
                    }
                  }
                });
                
                console.log('Chart created successfully:', chart);
                canvas.style.border = '2px solid green';
                
              } catch (error) {
                console.error('Error creating chart:', error);
                canvas.style.border = '2px solid red';
              }
            });
          </script>
        </div>
        <div class="col-md-4">
          <h6 class="text-muted"><%= t('ai_analysis.statistics') %></h6>
          <% if @analysis_data && @analysis_data["statistics"] %>
            <ul class="list-group list-group-flush">
              <% @analysis_data["statistics"].each do |key, value| %>
                <li class="list-group-item d-flex justify-content-between">
                  <span><%= key %></span>
                  <span class="font-weight-bold"><%= value %></span>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p><%= t('ai_analysis.data_unavailable') %></p>
          <% end %>
          
          <hr>
          <h6 class="text-danger"><%= t('ai_analysis.key_anomalies') %></h6>
          <% if @analysis_data && @analysis_data["events"] && @analysis_data["events"].any? %>
            <div class="list-group">
              <% @analysis_data["events"].first(3).each do |event| %>
                <div class="list-group-item">
                  <div class="d-flex w-100 justify-content-between">
                    <h6 class="mb-1"><%= t('ai_analysis.event.value') %>: <%= event["value"] %></h6>
                    <small><%= l(Time.at(event["timestamp"]), format: :short) %></small>
                  </div>
                  <p class="mb-1"><%= t('ai_analysis.event.deviation') %>: <span class="badge bg-danger"><%= event["deviation"] %>%</span></p>
                </div>
              <% end %>
            </div>
            <% if @analysis_data["events"].size > 3 %>
              <div class="text-center mt-2">
                <small><%= t('ai_analysis.showing_of', shown: 3, total: @analysis_data["events"].size) %></small>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% elsif analysis_type == 'trend_prediction' %>
  <!-- Детали анализа трендов -->
  <div class="card mb-4">
    <div class="card-header bg-warning text-dark">
      <h5 class="mb-0"><%= t('ai_analysis.models.trend_prediction.title') %></h5>
    </div>
    <div class="card-body">
      <div class="row">
        <div class="col-md-8">
          <canvas id="trend-chart" width="800" height="350" style="border: 1px solid #ddd;"></canvas>
          
          <script>
            // Простое создание графика трендов без Stimulus
            document.addEventListener('DOMContentLoaded', function() {
              console.log('=== MANUAL TREND CHART CREATION ===');
              
              const canvas = document.getElementById('trend-chart');
              if (!canvas) {
                console.error('Trend canvas not found');
                return;
              }
              
              // Проверяем загрузку Chart.js
              if (typeof Chart === 'undefined') {
                console.error('Chart.js not loaded for trends');
                canvas.style.border = '2px solid red';
                return;
              }
              
              console.log('Creating trend chart...');
              
              // Получаем данные анализа
              const analysisData = <%= raw @analysis_data.to_json %>;
              console.log('Trend analysis data:', analysisData);
              
              const chartData = analysisData.chart_data;
              if (!chartData) {
                console.error('No chart data for trends');
                canvas.style.border = '2px solid orange';
                return;
              }
              
              // Цвета для серий
              const colors = [
                { border: 'rgba(75, 192, 192, 1)', bg: 'rgba(75, 192, 192, 0.2)' },
                { border: 'rgba(255, 99, 132, 1)', bg: 'rgba(255, 99, 132, 0.2)' },
                { border: 'rgba(54, 162, 235, 1)', bg: 'rgba(54, 162, 235, 0.2)' },
                { border: 'rgba(255, 206, 86, 1)', bg: 'rgba(255, 206, 86, 0.2)' },
                { border: 'rgba(153, 102, 255, 1)', bg: 'rgba(153, 102, 255, 0.2)' },
                { border: 'rgba(255, 159, 64, 1)', bg: 'rgba(255, 159, 64, 0.2)' }
              ];
              
              const predictionColors = [
                { border: 'rgba(75, 192, 192, 0.7)', bg: 'rgba(75, 192, 192, 0.1)' },
                { border: 'rgba(255, 99, 132, 0.7)', bg: 'rgba(255, 99, 132, 0.1)' },
                { border: 'rgba(54, 162, 235, 0.7)', bg: 'rgba(54, 162, 235, 0.1)' },
                { border: 'rgba(255, 206, 86, 0.7)', bg: 'rgba(255, 206, 86, 0.1)' },
                { border: 'rgba(153, 102, 255, 0.7)', bg: 'rgba(153, 102, 255, 0.1)' },
                { border: 'rgba(255, 159, 64, 0.7)', bg: 'rgba(255, 159, 64, 0.1)' }
              ];
              
              // Форматируем метки времени
              const formatTimestamp = (ts) => {
                const date = new Date(ts * 1000);
                return date.toLocaleString('<%= I18n.locale %>', { hour: '2-digit', minute: '2-digit', day: '2-digit', month: '2-digit' });
              };
              
              let labels = [];
              let datasets = [];
              
              // Проверяем есть ли несколько серий
              if (chartData.series && chartData.series.length > 0) {
                console.log('Multiple series detected:', chartData.series.length);
                
                // Собираем все уникальные временные метки
                const allTimestamps = new Set();
                chartData.series.forEach(series => {
                  (series.current_timestamps || []).forEach(ts => allTimestamps.add(ts));
                  (series.prediction_timestamps || []).forEach(ts => allTimestamps.add(ts));
                });
                
                const sortedTimestamps = Array.from(allTimestamps).sort((a, b) => a - b);
                labels = sortedTimestamps.map(formatTimestamp);
                
                // Создаем датасеты для каждой серии
                chartData.series.forEach((series, idx) => {
                  const colorIdx = idx % colors.length;
                  const label = series.label || `Series ${idx + 1}`;
                  
                  const currentTs = series.current_timestamps || [];
                  const currentVals = series.current_values || [];
                  const predTs = series.prediction_timestamps || [];
                  const predVals = series.prediction_values || [];
                  
                  // Текущие данные
                  const currentData = sortedTimestamps.map(ts => {
                    const i = currentTs.indexOf(ts);
                    return i >= 0 ? currentVals[i] : null;
                  });
                  
                  // Прогноз
                  const predictionData = sortedTimestamps.map(ts => {
                    const i = predTs.indexOf(ts);
                    return i >= 0 ? predVals[i] : null;
                  });
                  
                  datasets.push({
                    label: label,
                    data: currentData,
                    borderColor: colors[colorIdx].border,
                    backgroundColor: colors[colorIdx].bg,
                    tension: 0.1,
                    pointRadius: 2
                  });
                  
                  datasets.push({
                    label: label + ' (<%= t('ai_analysis.chart.forecast') %>)',
                    data: predictionData,
                    borderColor: predictionColors[colorIdx].border,
                    backgroundColor: predictionColors[colorIdx].bg,
                    tension: 0.1,
                    pointRadius: 2,
                    borderDash: [5, 5]
                  });
                });
                
              } else {
                // Старый формат - одна серия
                const currentTimestamps = chartData.current_timestamps || [];
                const currentValues = chartData.current_values || [];
                const predictionTimestamps = chartData.prediction_timestamps || [];
                const predictionValues = chartData.prediction_values || [];
                
                const currentLabels = currentTimestamps.map(formatTimestamp);
                const predictionLabels = predictionTimestamps.map(formatTimestamp);
                labels = [...currentLabels, ...predictionLabels];
                
                const currentDataset = [...currentValues, ...Array(predictionValues.length).fill(null)];
                const predictionDataset = [...Array(currentValues.length).fill(null), ...predictionValues];
                
                datasets = [
                  {
                    label: '<%= t('ai_analysis.chart.current_values') %>',
                    data: currentDataset,
                    borderColor: 'rgba(75, 192, 192, 1)',
                    backgroundColor: 'rgba(75, 192, 192, 0.2)',
                    tension: 0.1,
                    pointRadius: 3
                  },
                  {
                    label: '<%= t('ai_analysis.chart.forecast') %>',
                    data: predictionDataset,
                    borderColor: 'rgba(255, 205, 86, 1)',
                    backgroundColor: 'rgba(255, 205, 86, 0.2)',
                    tension: 0.1,
                    pointRadius: 3,
                    borderDash: [5, 5]
                  }
                ];
              }
              
              if (labels.length === 0) {
                console.error('No timestamp data available');
                canvas.style.border = '2px solid orange';
                return;
              }
              
              // Создаем график
              const ctx = canvas.getContext('2d');
              
              try {
                const chart = new Chart(ctx, {
                  type: 'line',
                  data: {
                    labels: labels,
                    datasets: datasets
                  },
                  options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                      x: {
                        grid: {
                          display: false
                        },
                        ticks: {
                          maxTicksAuto: 10,
                          maxRotation: 45
                        }
                      }
                    },
                    plugins: {
                      tooltip: {
                        mode: 'index',
                        intersect: false
                      },
                      legend: {
                        position: 'bottom',
                        labels: {
                          boxWidth: 12,
                          padding: 8,
                          font: { size: 10 }
                        }
                      },
                      title: {
                        display: true,
                        text: '<%= t('ai_analysis.chart.trend_title') %>'
                      }
                    }
                  }
                });
                
                console.log('Trend chart created successfully:', chart);
                canvas.style.border = '2px solid green';
                
              } catch (error) {
                console.error('Error creating trend chart:', error);
                canvas.style.border = '2px solid red';
              }
            });
          </script>
        </div>
        <div class="col-md-4">
          <div class="alert 
            <% if @analysis_data && @analysis_data["statistics"] && @analysis_data["statistics"]["Изменение"] %>
              <% change = @analysis_data["statistics"]["Изменение"].to_s %>
              <% if change.start_with?('+') && change.to_f > 10 %>
                alert-danger
              <% elsif change.start_with?('+') %>
                alert-warning
              <% elsif change.start_with?('-') && change.to_f < -10 %>
                alert-primary
              <% else %>
                alert-success
              <% end %>
            <% else %>
              alert-secondary
            <% end %>">
            <h6 class="alert-heading"><%= t('ai_analysis.forecast_change') %></h6>
            <% if @analysis_data && @analysis_data["statistics"] && @analysis_data["statistics"]["Изменение"] %>
              <h4><%= @analysis_data["statistics"]["Изменение"] %></h4>
            <% else %>
              <h4><%= t('common.na') %></h4>
            <% end %>
            <hr>
            <p class="mb-0">
              <% if @analysis_data && @analysis_data["insights"] && @analysis_data["insights"].first && @analysis_data["insights"].first["title"] %>
                <%= @analysis_data["insights"].first["title"] %>
              <% else %>
                <%= t('ai_analysis.no_forecast_data') %>
              <% end %>
            </p>
          </div>
          
          <h6 class="text-muted mt-3"><%= t('ai_analysis.statistics') %></h6>
          <% if @analysis_data && @analysis_data["statistics"] %>
            <ul class="list-group list-group-flush">
              <% @analysis_data["statistics"].except("Изменение").each do |key, value| %>
                <li class="list-group-item d-flex justify-content-between">
                  <span><%= key %></span>
                  <span class="font-weight-bold"><%= value %></span>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p><%= t('ai_analysis.data_unavailable') %></p>
          <% end %>
          
          <h6 class="text-warning mt-3"><%= t('ai_analysis.forecast_points') %></h6>
          <% if @analysis_data && @analysis_data["events"] && @analysis_data["events"].any? %>
            <div class="table-responsive">
              <table class="table table-sm">
                <thead>
                  <tr>
                    <th><%= t('ai_analysis.event.date') %></th>
                    <th><%= t('ai_analysis.event.value') %></th>
                  </tr>
                </thead>
                <tbody>
                  <% @analysis_data["events"].first(5).each do |event| %>
                    <tr>
                      <td><%= l(Time.at(event["timestamp"]), format: :short) %></td>
                      <td><%= event["value"] %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <p><%= t('ai_analysis.forecast_unavailable') %></p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% elsif analysis_type == 'performance_insight' %>
  <!-- Детали анализа производительности -->
  <div class="card mb-4">
    <div class="card-header bg-info text-white">
      <h5 class="mb-0"><%= t('ai_analysis.models.performance_insight.title') %></h5>
    </div>
    <div class="card-body">
      <% chart_data = @analysis_data&.dig("chart_data") || {} %>
      <% feature_importance = chart_data["feature_importance"] || @analysis_data&.dig("feature_importance") %>
      <% predictions = chart_data["predictions"] || @analysis_data&.dig("predictions") %>
      <% current_values = chart_data["current_values"] || [] %>
      <% current_timestamps = chart_data["current_timestamps"] || [] %>
      
      <div class="row">
        <div class="col-md-8">
          <!-- График текущих значений метрики -->
          <% if current_values.any? %>
          <div class="card mb-3">
            <div class="card-header bg-light">
              <h6 class="mb-0"><%= t('ai_analysis.current_metric_values') %></h6>
            </div>
            <div class="card-body">
              <canvas id="performance-current-chart" height="200"></canvas>
              <script>
                document.addEventListener('DOMContentLoaded', function() {
                  const ctx = document.getElementById('performance-current-chart');
                  if (ctx) {
                    new Chart(ctx, {
                      type: 'line',
                      data: {
                        labels: <%= current_timestamps.map { |ts| Time.at(ts).strftime('%H:%M') }.to_json.html_safe %>,
                        datasets: [{
                          label: '<%= t("ai_analysis.value") %>',
                          data: <%= current_values.to_json %>,
                          borderColor: 'rgb(54, 162, 235)',
                          backgroundColor: 'rgba(54, 162, 235, 0.1)',
                          fill: true,
                          tension: 0.3
                        }]
                      },
                      options: {
                        responsive: true,
                        plugins: { legend: { display: false } },
                        scales: { y: { beginAtZero: true } }
                      }
                    });
                  }
                });
              </script>
            </div>
          </div>
          <% end %>
          
          <!-- Круговая диаграмма для факторов влияния -->
          <div class="card mb-3">
            <div class="card-header bg-light">
              <h6 class="mb-0"><%= t('ai_analysis.performance_factors') %></h6>
            </div>
            <div class="card-body">
              <% if feature_importance.present? %>
                <canvas id="feature-importance-chart" height="250"></canvas>
                <script>
                  document.addEventListener('DOMContentLoaded', function() {
                    const ctx = document.getElementById('feature-importance-chart');
                    if (ctx) {
                      const data = <%= feature_importance.to_json.html_safe %>;
                      const labels = Object.keys(data).map(k => {
                        const translations = {
                          'current_value': '<%= t("ai_analysis.factors.current_value") %>',
                          'moving_average': '<%= t("ai_analysis.factors.moving_average") %>',
                          'max_in_window': '<%= t("ai_analysis.factors.max_in_window") %>'
                        };
                        return translations[k] || k;
                      });
                      const values = Object.values(data).map(v => (v * 100).toFixed(1));
                      
                      new Chart(ctx, {
                        type: 'doughnut',
                        data: {
                          labels: labels,
                          datasets: [{
                            data: values,
                            backgroundColor: ['#4e73df', '#1cc88a', '#36b9cc']
                          }]
                        },
                        options: {
                          responsive: true,
                          plugins: {
                            legend: { position: 'bottom' },
                            tooltip: {
                              callbacks: {
                                label: function(context) {
                                  return context.label + ': ' + context.raw + '%';
                                }
                              }
                            }
                          }
                        }
                      });
                    }
                  });
                </script>
              <% else %>
                <div class="alert alert-warning"><%= t('ai_analysis.factors_unavailable') %></div>
              <% end %>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <h6 class="text-muted"><%= t('ai_analysis.statistics') %></h6>
          <% if @analysis_data && @analysis_data["statistics"] %>
            <ul class="list-group list-group-flush">
              <% @analysis_data["statistics"].each do |key, value| %>
                <li class="list-group-item d-flex justify-content-between">
                  <span><%= key %></span>
                  <span class="font-weight-bold"><%= value %></span>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p><%= t('ai_analysis.data_unavailable') %></p>
          <% end %>
          
          <hr>
          <h6 class="text-info"><%= t('ai_analysis.ai_conclusions') %></h6>
          <% if @analysis_data && @analysis_data["insights"] && @analysis_data["insights"].any? %>
            <div class="accordion" id="insightsAccordion">
              <% @analysis_data["insights"].each_with_index do |insight, index| %>
                <div class="accordion-item">
                  <h2 class="accordion-header" id="heading<%= index %>">
                    <button class="accordion-button <%= index > 0 ? 'collapsed' : '' %>" type="button" 
                            data-bs-toggle="collapse" data-bs-target="#collapse<%= index %>" 
                            aria-expanded="<%= index == 0 ? 'true' : 'false' %>" aria-controls="collapse<%= index %>">
                      <%= insight["title"] %>
                    </button>
                  </h2>
                  <div id="collapse<%= index %>" class="accordion-collapse collapse <%= index == 0 ? 'show' : '' %>" 
                       aria-labelledby="heading<%= index %>" data-bs-parent="#insightsAccordion">
                    <div class="accordion-body">
                      <p><%= insight["description"] %></p>
                      <% if insight["recommendation"].present? %>
                        <div class="alert alert-info">
                          <strong><%= t('ai_analysis.recommendation') %></strong> <%= insight["recommendation"] %>
                        </div>
                      <% end %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="alert alert-secondary"><%= t('ai_analysis.no_conclusions') %></div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>
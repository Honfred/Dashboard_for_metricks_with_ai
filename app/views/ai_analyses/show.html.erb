<div class="container mt-4" 
     data-controller="ai-analysis" 
     data-ai-analysis-analysis-id-value="<%= @ai_analysis.id %>"
     data-ai-analysis-metric-id-value="<%= @metric.id %>">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><%= link_to t('breadcrumbs.metrics'), metrics_path %></li>
      <li class="breadcrumb-item"><%= link_to @metric.name, metric_path(@metric) %></li>
      <li class="breadcrumb-item"><%= link_to t('ai_analysis.title'), metric_ai_analyses_path(@metric) %></li>
      <li class="breadcrumb-item active" aria-current="page"><%= t('ai_analysis.analysis_number', id: @ai_analysis.id) %></li>
    </ol>
  </nav>

  <div class="row mb-4">
    <div class="col-12">
      <div class="card">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
          <h5 class="mb-0"><%= t('ai_analysis.results_title', type: @ai_analysis.analysis_type.humanize) %></h5>
          <span class="badge bg-light text-dark">
            <%= l(@ai_analysis.created_at, format: :default) %>
          </span>
        </div>
        <div class="card-body">
          <% if @ai_analysis.completed? %>
            <!-- Рендеринг детального представления на основе типа анализа -->
            <%= render 'analysis_details', analysis_type: @ai_analysis.analysis_type %>
          <% elsif @ai_analysis.failed? %>
            <div class="alert alert-danger">
              <h4 class="alert-heading"><%= t('ai_analysis.error_title') %></h4>
              <p><%= t('ai_analysis.error_message') %></p>
              <hr>
              <p class="mb-0">
                <%= @ai_analysis.results["message"] if @ai_analysis.results.present? && @ai_analysis.results["message"].present? %>
              </p>
            </div>
            <div class="text-center mt-3">
              <%= link_to t('ai_analysis.try_again'), new_metric_ai_analysis_path(@metric, type: @ai_analysis.analysis_type), class: 'btn btn-primary' %>
            </div>
          <% else %>
            <div class="text-center py-5" data-ai-analysis-target="refreshable" data-refresh-status="true">
              <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden"><%= t('common.loading') %></span>
              </div>
              <h5 class="mt-3"><%= t('ai_analysis.in_progress') %></h5>
              <p class="text-muted"><%= t('ai_analysis.may_take_time') %></p>
              
              <!-- Индикатор статуса проверки -->
              <div id="status-indicator" class="mt-3">
                <small class="text-info">
                  <i class="fas fa-sync-alt fa-spin"></i>
                  <%= t('ai_analysis.auto_check_status') %>
                </small>
              </div>
              
              <% if Time.current - @ai_analysis.created_at > 5.minutes %>
                <div class="alert alert-warning mt-3">
                  <p><strong><%= t('ai_analysis.attention') %></strong> <%= t('ai_analysis.taking_longer') %></p>
                  <p><%= t('ai_analysis.possible_reasons') %></p>
                  <ul class="text-start">
                    <li><%= t('ai_analysis.reasons.large_data') %></li>
                    <li><%= t('ai_analysis.reasons.high_load') %></li>
                    <li><%= t('ai_analysis.reasons.ml_connection') %></li>
                  </ul>
                  <div class="mt-3">
                    <%= link_to t('ai_analysis.refresh_page'), metric_ai_analysis_path(@metric, @ai_analysis), class: 'btn btn-outline-primary' %>
                    <button class="btn btn-outline-secondary ms-2" data-action="click->ai-analysis#refresh">
                      <i class="fas fa-sync-alt"></i> <%= t('ai_analysis.refresh_now') %>
                    </button>
                    <%= link_to t('ai_analysis.check_ml_status'), '#', class: 'btn btn-outline-secondary ms-2', id: 'check-ml-service' %>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <% if @ai_analysis.completed? || (@analysis_data && @analysis_data.present?) %>
  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="card-header bg-primary text-white">
          <h5 class="mb-0"><%= t('ai_analysis.events_and_insights') %></h5>
        </div>
        <div class="card-body">
          <% detailed_insights = @analysis_data&.dig("detailed_insights") || @analysis_data&.dig("insights") %>
          <% if detailed_insights && detailed_insights.respond_to?(:any?) && detailed_insights.any? %>
            <div class="row">
              <% detailed_insights.each do |insight| %>
                <div class="col-lg-4 col-md-6 mb-3">
                  <div class="card h-100 border-<%= insight["severity"] == "high" ? "danger" : insight["severity"] == "medium" ? "warning" : "info" %>">
                    <div class="card-header bg-<%= insight["severity"] == "high" ? "danger" : insight["severity"] == "medium" ? "warning" : "info" %> text-<%= insight["severity"] == "medium" ? "dark" : "white" %>">
                      <h6 class="mb-0"><%= insight["title"] %></h6>
                    </div>
                    <div class="card-body">
                      <p><%= insight["description"] %></p>
                      <% if insight["recommendation"].present? %>
                        <div class="alert alert-light">
                          <strong><%= t('ai_analysis.recommendation') %></strong> <%= insight["recommendation"] %>
                        </div>
                      <% end %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="alert alert-info">
              <p class="mb-0"><%= t('ai_analysis.no_insights') %></p>
            </div>
          <% end %>
          
          <hr>
          
          <div class="table-responsive mt-4">
            <h6><%= t('ai_analysis.events') %></h6>
            <table class="table table-striped table-hover">
              <thead>
                <tr>
                  <th><%= t('ai_analysis.event.timestamp') %></th>
                  <th><%= t('ai_analysis.event.type') %></th>
                  <th><%= t('ai_analysis.event.value') %></th>
                  <th><%= t('ai_analysis.event.deviation') %></th>
                  <th><%= t('ai_analysis.event.description') %></th>
                </tr>
              </thead>
              <tbody>
                <% if @analysis_data && @analysis_data["events"] && @analysis_data["events"].any? %>
                  <% @analysis_data["events"].each do |event| %>
                    <tr class="<%= event["type"] == "anomaly" ? "table-danger" : event["type"] == "prediction" ? "table-warning" : "table-info" %>">
                      <td><%= l(Time.at(event["timestamp"]), format: :default) %></td>
                      <td><span class="badge bg-<%= event["type"] == "anomaly" ? "danger" : event["type"] == "prediction" ? "warning text-dark" : "info" %>"><%= event["type"] %></span></td>
                      <td><%= event["value"] %></td>
                      <td><%= event["deviation"] %>%</td>
                      <td><%= event["description"] %></td>
                    </tr>
                  <% end %>
                <% else %>
                  <tr>
                    <td colspan="5" class="text-center"><%= t('ai_analysis.no_events') %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
        <div class="card-footer d-flex justify-content-between">
          <div>
            <%= link_to t('ai_analysis.export_json'), metric_ai_analysis_path(@metric, @ai_analysis, format: :json), class: 'btn btn-secondary' %>
            <%= link_to t('ai_analysis.export_csv'), metric_ai_analysis_path(@metric, @ai_analysis, format: :csv), class: 'btn btn-secondary' %>
          </div>
          <div>
            <%= link_to t('ai_analysis.create_new'), new_metric_ai_analysis_path(@metric), class: 'btn btn-primary' %>
          </div>
        </div>
      </div>
    </div>
  </div>
  <% end %>
</div>

<% unless @ai_analysis.completed? || @ai_analysis.failed? %>
  <script>
    // Автоматическое обновление страницы пока анализ выполняется
    setTimeout(function() {
      window.location.reload();
    }, 5000);
  </script>
<% end %>
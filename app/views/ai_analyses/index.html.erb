<div class="container mt-4">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><%= link_to t('breadcrumbs.home'), root_path %></li>
      <li class="breadcrumb-item active" aria-current="page"><%= t('ai_analysis.all_analyses') %></li>
    </ol>
  </nav>

  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1><%= t('ai_analysis.analyses_title') %></h1>
  </div>

  <div class="card">
    <div class="card-header bg-primary text-white">
      <h5 class="mb-0"><%= t('ai_analysis.all_analyses_in_system') %></h5>
    </div>
    <div class="card-body">
      <% if @ai_analyses.any? %>
        <div class="table-responsive">
          <table class="table table-hover">
            <thead>
              <tr>
                <th><%= t('ai_analysis.table.id') %></th>
                <th><%= t('ai_analysis.table.metric') %></th>
                <th><%= t('ai_analysis.table.analysis_type') %></th>
                <th><%= t('ai_analysis.table.created_at') %></th>
                <th><%= t('ai_analysis.table.actions') %></th>
              </tr>
            </thead>
            <tbody>
              <% @ai_analyses.each do |analysis| %>
                <tr>
                  <td><%= analysis.id %></td>
                  <td>
                    <%= link_to analysis.metric.name, metric_path(analysis.metric) %>
                  </td>
                  <td><span class="badge bg-info"><%= analysis.analysis_type.humanize %></span></td>
                  <td><%= l(analysis.created_at, format: :default) %></td>
                  <td>
                    <%= link_to t('common.view'), metric_ai_analysis_path(analysis.metric, analysis), class: 'btn btn-sm btn-primary' %>
                    <%= link_to 'JSON', metric_ai_analysis_path(analysis.metric, analysis, format: :json), class: 'btn btn-sm btn-secondary' %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="alert alert-info">
          <%= t('ai_analysis.no_analyses') %>
        </div>
      <% end %>
    </div>
  </div>
</div>
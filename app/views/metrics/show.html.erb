<div class="container mt-4" data-controller="metrics-chart">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><%= link_to 'Метрики', metrics_path %></li>
      <li class="breadcrumb-item active" aria-current="page"><%= @metric.name %></li>
    </ol>
  </nav>

  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1><%= @metric.name %></h1>
    <div class="btn-group">
      <button class="btn btn-outline-primary" data-action="metrics-chart#refreshData">Обновить данные</button>
      <div class="btn-group" role="group">
        <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
          Временной диапазон
        </button>
        <ul class="dropdown-menu">
          <li><a class="dropdown-item" href="<%= metric_path(@metric, time_range: '30m') %>">30 минут</a></li>
          <li><a class="dropdown-item" href="<%= metric_path(@metric, time_range: '1h') %>">1 час</a></li>
          <li><a class="dropdown-item" href="<%= metric_path(@metric, time_range: '3h') %>">3 часа</a></li>
          <li><a class="dropdown-item" href="<%= metric_path(@metric, time_range: '12h') %>">12 часов</a></li>
          <li><a class="dropdown-item" href="<%= metric_path(@metric, time_range: '24h') %>">24 часа</a></li>
          <li><a class="dropdown-item" href="<%= metric_path(@metric, time_range: '7d') %>">7 дней</a></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="row mb-4">
    <div class="col-md-8">
      <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h5 class="mb-0">Данные метрики</h5>
          <span class="badge bg-secondary">Тип: <%= @metric.metric_type %></span>
        </div>
        <div class="card-body">
          <canvas id="metrics-chart" data-metrics-chart-target="chart" style="height: 400px;" data-metric-name="<%= @metric.name %>" data-metric-id="<%= @metric.id %>" data-time-range="<%= params[:time_range] || '1h' %>"></canvas>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card shadow-sm" data-controller="anomaly-detection">
        <div class="card-header bg-primary text-white">
          <h5 class="mb-0">ИИ Анализ</h5>
        </div>
        <div class="card-body">
          <% if @ai_analyses.any? %>
            <ul class="list-group">
              <% @ai_analyses.each do |analysis| %>
                <li class="list-group-item">
                  <div class="d-flex justify-content-between align-items-center">
                    <h6 class="mb-1"><%= analysis.analysis_type.humanize %></h6>
                    <small><%= analysis.created_at.strftime("%d.%m.%Y %H:%M") %></small>
                  </div>
                  <%= link_to 'Подробнее', metric_ai_analysis_path(@metric, analysis), class: 'btn btn-sm btn-outline-primary mt-2' %>
                </li>
              <% end %>
            </ul>
          <% else %>
            <div class="alert alert-info">
              Для данной метрики еще не проводился ИИ-анализ.
            </div>
          <% end %>
          
          <div class="mt-3">
            <%= link_to 'Запустить новый анализ', new_metric_ai_analysis_path(@metric), class: 'btn btn-success w-100' %>
          </div>
        </div>
      </div>
      
      <div class="card shadow-sm mt-3">
        <div class="card-header bg-info text-white">
          <h5 class="mb-0">Статистика</h5>
        </div>
        <div class="card-body">
          <div class="row">
            <div class="col-6 mb-3">
              <div class="bg-light rounded p-2 text-center">
                <div class="small text-muted">Среднее</div>
                <div class="fw-bold" id="metric-average">Загрузка...</div>
              </div>
            </div>
            <div class="col-6 mb-3">
              <div class="bg-light rounded p-2 text-center">
                <div class="small text-muted">Максимум</div>
                <div class="fw-bold" id="metric-maximum">Загрузка...</div>
              </div>
            </div>
            <div class="col-6 mb-3">
              <div class="bg-light rounded p-2 text-center">
                <div class="small text-muted">Минимум</div>
                <div class="fw-bold" id="metric-minimum">Загрузка...</div>
              </div>
            </div>
            <div class="col-6 mb-3">
              <div class="bg-light rounded p-2 text-center">
                <div class="small text-muted">P95</div>
                <div class="fw-bold" id="metric-p95">Загрузка...</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script nonce="<%= request.content_security_policy_nonce %>">
// Код для обновления статистики
document.addEventListener('DOMContentLoaded', function() {
  // При загрузке страницы делаем запрос данных
  fetchMetricData();
  
  // Кнопка обновления данных
  const refreshButton = document.querySelector('[data-action="metrics-chart#refreshData"]');
  if (refreshButton) {
    refreshButton.addEventListener('click', fetchMetricData);
  }
  
  function fetchMetricData() {
    const metricId = <%= @metric.id %>;
    const timeRange = '<%= params[:time_range] || "1h" %>';
    
    fetch(`/metrics/${metricId}.json?time_range=${timeRange}`)
      .then(response => {
        if (!response.ok) {
          throw new Error('Ошибка загрузки данных');
        }
        return response.json();
      })
      .then(data => {
        updateStatistics(data);
      })
      .catch(error => {
        console.error('Ошибка при загрузке данных метрики:', error);
      });
  }
  
  function updateStatistics(data) {
    if (!data || !data.data || data.data.length === 0) {
      document.getElementById("metric-average").textContent = "Нет данных";
      document.getElementById("metric-maximum").textContent = "Нет данных";
      document.getElementById("metric-minimum").textContent = "Нет данных";
      document.getElementById("metric-p95").textContent = "Нет данных";
      return;
    }
    
    // Объединяем все значения со всех метрик
    let allValues = [];
    
    data.data.forEach(metricItem => {
      if (metricItem.values && metricItem.values.length > 0) {
        const values = metricItem.values
          .map(point => Array.isArray(point) && point.length >= 2 ? parseFloat(point[1]) : NaN)
          .filter(val => !isNaN(val));
        
        allValues = allValues.concat(values);
      }
    });
    
    if (allValues.length === 0) {
      document.getElementById("metric-average").textContent = "Нет данных";
      document.getElementById("metric-maximum").textContent = "Нет данных";
      document.getElementById("metric-minimum").textContent = "Нет данных";
      document.getElementById("metric-p95").textContent = "Нет данных";
      return;
    }
    
    const average = allValues.reduce((sum, val) => sum + val, 0) / allValues.length;
    const maximum = Math.max(...allValues);
    const minimum = Math.min(...allValues);
    const sorted = [...allValues].sort((a, b) => a - b);
    const p95Index = Math.floor(sorted.length * 0.95);
    const p95 = sorted[p95Index];
    
    document.getElementById("metric-average").textContent = average.toFixed(2);
    document.getElementById("metric-maximum").textContent = maximum.toFixed(2);
    document.getElementById("metric-minimum").textContent = minimum.toFixed(2);
    document.getElementById("metric-p95").textContent = p95.toFixed(2);
  }
});
</script>
<div class="container mt-4">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><%= link_to t('breadcrumbs.metrics'), metrics_path %></li>
      <li class="breadcrumb-item active" aria-current="page"><%= t('metrics.new_metric') %></li>
    </ol>
  </nav>

  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card">
        <div class="card-header bg-primary text-white">
          <h5 class="mb-0"><%= t('metrics.adding_new_metric') %></h5>
        </div>
        <div class="card-body">
          <%= form_with(model: @metric, local: true) do |form| %>
            <% if @metric.errors.any? %>
              <div class="alert alert-danger">
                <h4><%= t('metrics.errors.saving', count: @metric.errors.count) %></h4>
                <ul>
                  <% @metric.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="mb-3">
              <%= form.label :name, t('metrics.metric_name'), class: 'form-label' %>
              <%= form.text_field :name, class: 'form-control', placeholder: t('metrics.metric_name_placeholder') %>
              <div class="form-text">
                <%= t('metrics.metric_name_hint') %>
              </div>
            </div>

            <div class="mb-3">
              <%= form.label :description, t('activerecord.attributes.metric.description'), class: 'form-label' %>
              <%= form.text_area :description, rows: 3, class: 'form-control', placeholder: t('activerecord.attributes.metric.description') %>
            </div>

            <div class="mb-3">
              <%= form.label :metric_type, t('activerecord.attributes.metric.metric_type'), class: 'form-label' %>
              <%= form.select :metric_type, 
                  Metric.metric_types.keys.map { |key| [key.humanize, key] }, 
                  { prompt: t('metrics.select_type_prompt') }, 
                  class: 'form-select' %>
            </div>

            <div class="d-flex justify-content-between">
              <%= link_to t('common.cancel'), metrics_path, class: 'btn btn-secondary' %>
              <%= form.submit t('common.save'), class: 'btn btn-success' %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
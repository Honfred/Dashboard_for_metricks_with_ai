<div class="container mt-4">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><%= link_to 'Метрики', metrics_path %></li>
      <li class="breadcrumb-item active" aria-current="page">Новая метрика</li>
    </ol>
  </nav>

  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card">
        <div class="card-header bg-primary text-white">
          <h5 class="mb-0">Добавление новой метрики</h5>
        </div>
        <div class="card-body">
          <%= form_with(model: @metric, local: true) do |form| %>
            <% if @metric.errors.any? %>
              <div class="alert alert-danger">
                <h4><%= pluralize(@metric.errors.count, "ошибка") %> при сохранении метрики:</h4>
                <ul>
                  <% @metric.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="mb-3">
              <%= form.label :name, 'Название метрики', class: 'form-label' %>
              <%= form.text_field :name, class: 'form-control', placeholder: 'api_response_time' %>
              <div class="form-text">
                Укажите название метрики в Prometheus, например: http_request_duration_seconds
              </div>
            </div>

            <div class="mb-3">
              <%= form.label :description, 'Описание', class: 'form-label' %>
              <%= form.text_area :description, rows: 3, class: 'form-control', placeholder: 'Время ответа API-эндпоинта' %>
            </div>

            <div class="mb-3">
              <%= form.label :metric_type, 'Тип метрики', class: 'form-label' %>
              <%= form.select :metric_type, 
                  Metric.metric_types.keys.map { |key| [key.humanize, key] }, 
                  { prompt: "Выберите тип метрики" }, 
                  class: 'form-select' %>
            </div>

            <div class="d-flex justify-content-between">
              <%= link_to 'Отмена', metrics_path, class: 'btn btn-secondary' %>
              <%= form.submit 'Сохранить', class: 'btn btn-success' %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
<div class="container mt-4">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><%= t('metrics.title') %></h1>
        <%= link_to t('metrics.add_metric'), new_metric_path, class: "btn btn-primary" %>
      </div>
      
      <div class="row">
        <!-- Колонка с доступными метриками -->
        <div class="col-md-8 metrics-section">
          <div class="card">
            <div class="card-header">
              <%= t('metrics.available_metrics') %>
            </div>
            <div class="card-body">
              <% if @metrics.present? %>
                <table class="table table-striped metrics-table">
                  <thead>
                    <tr>
                      <th><%= t('metrics.table.name') %></th>
                      <th><%= t('metrics.table.type') %></th>
                      <th><%= t('metrics.table.description') %></th>
                      <th><%= t('metrics.table.actions') %></th>
                    </tr>
                  </thead>
                  <tbody>
                    <% @metrics.each do |metric| %>
                      <tr>
                        <td><%= link_to metric.name, metric_path(metric) %></td>
                        <td><%= metric.metric_type %></td>
                        <td><%= metric.description %></td>
                        <td>
                          <%= link_to t('common.view'), metric_path(metric), class: "btn btn-sm btn-outline-primary" %>
                          <% if current_user&.admin? %>
                            <%= link_to t('common.edit'), edit_metric_path(metric), class: "btn btn-sm btn-outline-secondary" %>
                            <%= link_to t('common.delete'), metric_path(metric), 
                                      method: :delete, 
                                      data: { confirm: t('metrics.confirm_delete') }, 
                                      class: "btn btn-sm btn-outline-danger" %>
                          <% end %>
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              <% else %>
                <div class="no-data-message">
                  <%= t('metrics.no_metrics') %> <%= link_to t('metrics.add_first_metric'), new_metric_path if current_user&.admin? %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
        
        <!-- Колонка с источниками данных -->
        <div class="col-md-4 metrics-section">
          <div class="card">
            <div class="card-header">
              <%= t('metrics.data_sources.title') %>
            </div>
            <div class="card-body">
              <% if @available_targets&.any? %>
                <div class="data-sources-list">
                  <% @available_targets.each do |target| %>
                    <div class="data-source-item <%= target[:active] ? 'active' : 'inactive' %>">
                      <strong><%= target[:instance] %></strong>
                      <div class="small text-muted"><%= target[:job] %></div>
                      <div class="badge <%= target[:active] ? 'bg-success' : 'bg-danger' %>">
                        <%= target[:active] ? t('metrics.data_sources.active') : t('metrics.data_sources.inactive') %>
                      </div>
                      <div class="small text-muted mt-1">
                        <%= t('metrics.data_sources.last_update') %> <%= target[:last_scrape] ? l(Time.parse(target[:last_scrape]), format: :default) : t('common.unknown') %>
                      </div>
                    </div>
                  <% end %>
                </div>
              <% else %>
                <div class="no-data-message">
                  <%= t('metrics.data_sources.no_sources') %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= t('dashboard.title') %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    
    <!-- Базовые стили CSS Bootstrap для улучшения внешнего вида -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    
    <!-- Font Awesome для иконок -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <%= javascript_importmap_tags %>
    
    <!-- Chart.js (глобальный, единая версия для всех страниц с inline-графиками) -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>

    <%= yield :styles %>
  </head>

  <body class="dashboard-app <%= controller_name %> <%= action_name %>">
    <header>
      <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
          <a class="navbar-brand" href="/"><%= t('common.brand_name') %></a>
          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
          </button>
          <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav">
              <li class="nav-item">
                <a class="nav-link <%= current_page?(root_path) ? 'active' : '' %>" href="/"><%= t('navigation.metrics') %></a>
              </li>
              <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle <%= controller_name == 'ai_analyses' || (controller_name == 'dashboard' && action_name == 'ai_overview') ? 'active' : '' %>" href="#" id="aiDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                  <%= t('navigation.ai_analysis') %>
                </a>
                <ul class="dropdown-menu" aria-labelledby="aiDropdown">
                  <li><a class="dropdown-item" href="/ai_analyses"><%= t('navigation.analysis_list') %></a></li>
                  <li><a class="dropdown-item" href="/dashboard/ai_overview"><%= t('navigation.ai_dashboard') %></a></li>
                </ul>
              </li>
              <li class="nav-item">
                <a class="nav-link <%= current_page?(prometheus_status_path) ? 'active' : '' %>" href="/prometheus/status"><%= t('navigation.data_sources_status') %></a>
              </li>
              <li class="nav-item">
                <a class="nav-link <%= current_page?(dashboard_index_path) ? 'active' : '' %>" href="/dashboard"><%= t('navigation.dashboard') %></a>
              </li>
              <li class="nav-item">
                <a class="nav-link <%= controller_name == 'alerts' ? 'active' : '' %>" href="/alerts"><%= t('navigation.alerts') %></a>
              </li>
              <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle <%= %w[uploads reports ml_models].include?(controller_name) ? 'active' : '' %>" href="#" id="storageDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                  <i class="bi bi-cloud"></i> <%= t('navigation.uploads') %>
                </a>
                <ul class="dropdown-menu" aria-labelledby="storageDropdown">
                  <li><a class="dropdown-item <%= controller_name == 'uploads' ? 'active' : '' %>" href="/uploads"><%= t('navigation.uploads') %></a></li>
                  <li><a class="dropdown-item <%= controller_name == 'reports' ? 'active' : '' %>" href="/reports"><%= t('navigation.reports') %></a></li>
                  <li><hr class="dropdown-divider"></li>
                  <li><a class="dropdown-item <%= controller_name == 'ml_models' ? 'active' : '' %>" href="/ml_models"><%= t('navigation.ml_models') %></a></li>
                </ul>
              </li>
            </ul>
            
            <!-- Переключатель языков -->
            <ul class="navbar-nav ms-auto">
              <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle" href="#" id="localeDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                  <i class="fas fa-globe"></i> <%= t("locale.#{I18n.locale}") %>
                </a>
                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="localeDropdown">
                  <% I18n.available_locales.each do |locale| %>
                    <li>
                      <a class="dropdown-item <%= locale == I18n.locale ? 'active' : '' %>" 
                         href="<%= set_locale_path(locale) %>"
                         data-turbo="false">
                        <%= t("locale.#{locale}") %>
                      </a>
                    </li>
                  <% end %>
                </ul>
              </li>
            </ul>
          </div>
        </div>
      </nav>
    </header>

    <main class="container-fluid mt-4">
      <% if notice %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <%= notice %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>
      
      <% if alert %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <%= alert %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>
      
      <%= yield %>
    </main>

    <footer>
      <div class="container">
        <p>&copy; <%= Date.today.year %> <%= t('dashboard.title') %></p>
      </div>
    </footer>

    <!-- Bootstrap JS для функциональности компонентов -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <%= yield :scripts %>
  </body>
</html>

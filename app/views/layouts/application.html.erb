<!DOCTYPE html>
<html>
  <head>
    <title>Мониторинг производительности</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    
    <!-- Базовые стили CSS Bootstrap для улучшения внешнего вида -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    
    <!-- Font Awesome для иконок -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <%= javascript_importmap_tags %>
    
    <!-- Добавление Chart.js для визуализации метрик -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <!-- SortableJS для поддержки перетаскивания панелей -->
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
    
    <%= yield :styles %>
  </head>

  <body class="dashboard-app <%= controller_name %> <%= action_name %>">
    <header>
      <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
          <a class="navbar-brand" href="/">Metricks Dashboard</a>
          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
          </button>
          <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav">
              <li class="nav-item">
                <a class="nav-link <%= current_page?(root_path) ? 'active' : '' %>" href="/">Метрики</a>
              </li>
              <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle <%= controller_name == 'ai_analyses' || (controller_name == 'dashboard' && action_name == 'ai_overview') ? 'active' : '' %>" href="#" id="aiDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                  ИИ-анализ
                </a>
                <ul class="dropdown-menu" aria-labelledby="aiDropdown">
                  <li><a class="dropdown-item" href="/ai_analyses">Список анализов</a></li>
                  <li><a class="dropdown-item" href="/dashboard/ai_overview">Панель управления ИИ</a></li>
                </ul>
              </li>
              <li class="nav-item">
                <a class="nav-link <%= current_page?(prometheus_status_path) ? 'active' : '' %>" href="/prometheus/status">Статус источников</a>
              </li>
              <li class="nav-item">
                <a class="nav-link <%= current_page?(dashboard_index_path) ? 'active' : '' %>" href="/dashboard">Дашборд</a>
              </li>
            </ul>
          </div>
        </div>
      </nav>
    </header>

    <main class="container-fluid mt-4">
      <% if notice %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <%= notice %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>
      
      <% if alert %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <%= alert %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>
      
      <%= yield %>
    </main>

    <footer>
      <div class="container">
        <p>&copy; <%= Date.today.year %> Мониторинг производительности</p>
      </div>
    </footer>

    <!-- Bootstrap JS для функциональности компонентов -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <%= yield :scripts %>
  </body>
</html>
